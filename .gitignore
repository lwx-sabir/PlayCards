# Unity .gitignore (safe for Unity 2019+ through Unity 6)
# Keep: Assets/**, ProjectSettings/**, Packages/**, and all *.meta files

# =========================
# Unity generated folders
# =========================
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/

# .NET backend build output (the Build/ rule above doesn't cover bin/)
[Bb]in/
[Ll]ogs/
[Uu]ser[Ss]ettings/
[Mm]emoryCaptures/
[Rr]ecordings/

# Unity Package Manager cache inside Library (big, regenerates)
[Ll]ibrary/[Pp]ackage[Cc]ache/

# =========================
# Visual Studio / Rider / IDE
# =========================
.vs/
.idea/
*.DotSettings.user
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.opendb
*.VC.db

# Auto-generated solution/project files (Unity regenerates these)
*.csproj
*.sln
*.unityproj

# ...but the .NET backend's project/solution files ARE source — keep them tracked.
# NOTE: these paths must track the repo layout. They used to say /khela/PlayCards/... and were silently
# dead after the ~2026-06 flatten removed that nesting, so the blanket *.csproj / *.sln above swallowed the
# whole backend and a fresh clone had nothing buildable.
!/khela/Khela.Game/**/*.csproj
!/khela/Khela.Game/*.sln
!/khela/Khela.Common/**/*.csproj
!/khela/Khela.Common/*.sln

# Debug / symbol files (often huge)
*.pdb
*.mdb

# Exported/IDE caches
ExportedObj/
.consulo/

# =========================
# OS junk
# =========================
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# =========================
# Build artifacts
# =========================
*.apk
*.aab
*.app
*.unitypackage

# Crash reports
sysinfo.txt
mono_crash.*

# =========================
# Addressables (default)
# =========================
/ServerData
/[Aa]ssets/StreamingAssets/aa*
/[Aa]ssets/AddressableAssetsData/link.xml*
/[Aa]ssets/Addressables_Temp*
/[Aa]ssets/AddressableAssetsData/*/*.bin*

# =========================
# Visual Scripting generated
# =========================
/[Aa]ssets/Unity.VisualScripting.Generated/

# =========================
# Gradle (Android)
# =========================
.gradle/

# =========================
# Blender backup files (Unity can import .blend; don't commit backups)
# =========================
*.blend1
*.blend1.meta

# =========================
# OPTIONAL: Uncomment if you want to ignore AssetStoreTools plugin
# =========================
# /Assets/AssetStoreTools*

# =========================
# OPTIONAL (recommended): Burst/IL2CPP caches
# =========================
**/Il2CppBuildCache/
**/BurstDebugInformation*

# =========================
# Firebase — SDK + generated output (NOT source)
# On a fresh clone: re-import the Firebase Unity SDK 13.9.0 .unitypackage, then
# Assets ▸ External Dependency Manager ▸ Android Resolver ▸ Force Resolve.
# KEPT in VCS (project config / build templates): google-services.json,
# GoogleService-Info.plist, Plugins/Android/*.gradle + gradleTemplate.properties.
# =========================
/khela/Khela.Play/Assets/Firebase/
/khela/Khela.Play/Assets/Firebase.meta
/khela/Khela.Play/Assets/ExternalDependencyManager/
/khela/Khela.Play/Assets/ExternalDependencyManager.meta
/khela/Khela.Play/Assets/GeneratedLocalRepo/
/khela/Khela.Play/Assets/GeneratedLocalRepo.meta
/khela/Khela.Play/Assets/Editor Default Resources/Firebase/
/khela/Khela.Play/Assets/Editor Default Resources/Firebase.meta
/khela/Khela.Play/Assets/Plugins/iOS/Firebase/
/khela/Khela.Play/Assets/Plugins/iOS/Firebase.meta
/khela/Khela.Play/Assets/Plugins/tvOS/Firebase/
/khela/Khela.Play/Assets/Plugins/tvOS/Firebase.meta
/khela/Khela.Play/ProjectSettings/AndroidResolverDependencies.xml

# =========================
# Third-party asset packs — huge, re-downloadable from the Asset Store, NOT source.
# Keeping them out matters: the repo already uses Git LFS and is near GitHub's free quota.
# On a fresh clone: re-import the pack from the Unity Asset Store into the same path.
# =========================
/khela/Khela.Play/Assets/3PA/Textures/Mega Bundle 3 - 325+ Stylized Textures/
/khela/Khela.Play/Assets/3PA/Textures/Mega Bundle 3 - 325+ Stylized Textures.meta

# --- Secrets: OAuth client secrets must never be committed (keep server-side; rotate if leaked) ---
**/client_secret_*.apps.googleusercontent.com.json
**/client_secret_*.apps.googleusercontent.com.json.meta

# --- Secrets: Firebase Admin service-account key (server-side token verification) — treat like a password ---
**/firebase-service-account*.json
**/*firebase-adminsdk*.json

# Runtime config snapshots written by ConfigBackupService (server state, not source)
khela/Khela.Game/Khela.Game/App_Data/
