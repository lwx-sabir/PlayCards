  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "/var/khela/khela-.log",
          "rollingInterval": "Day",
          "rollOnFileSizeLimit": true,
          "fileSizeLimitBytes": 52428800,
          "retainedFileCountLimit": 30,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {SourceContext} {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "AllowedHosts": "*",

  "JwtSettings": {
    "SecretKey": "YourSuperSecretKeyHere_ChangeInProd",
    "Issuer": "YourCasinoApp",
    "Audience": "YourCasinoUsers",
    "ExpiryMinutes": 60
  },

  "Blackjack": {
    // Shoe. DeckCount is how many 52-card decks are in it (1..8; above 8 a hand could not be reconstructed by the
    // verifier). A shoe of 2+ decks PERSISTS across rounds and is replaced only when the cut card is reached.
    // ShoePenetrationPercent is how much of the shoe is dealt before the cut card sits (75 = cut at 25% remaining);
    // clamped to 10..95, and floored so a round can always finish. Ignored when the shoe reshuffles every round.
    //
    // ReshuffleEveryRound forces a fresh shuffle each round whatever the deck count. Note DeckCount 1 is NOT the
    // same as the original pre-shoe behaviour: that was six decks reshuffled every round, which is
    // DeckCount 6 + ReshuffleEveryRound true. DeckCount 1 is a single 52-card deck, a materially different game.
    "DeckCount": 6,
    "ShoePenetrationPercent": 75,
    "ReshuffleEveryRound": false,

    // Lobby stake tiers. A tier is a BRACKET, not a single table — the lobby opens as many tables per tier as the
    // players at that stake need (90 players at 3 seats = 30 tables) and reclaims the surplus when they leave.
    // Overridable live from the admin dashboard as a JSON array under the same key.
    "Tiers": [
      { "MinBet": 1000, "MaxBet": 10000 },
      { "MinBet": 5000, "MaxBet": 25000 },
      { "MinBet": 25000, "MaxBet": 100000 }
    ],
    // Floors held per tier at all times. MinJoinable counts tables with a FREE SEAT (they may already have players);
    // MinEmpty guarantees at least one completely free table, which the lobby sorts last, so a player can always
    // choose to play alone. EmptyTableGrace stops a table vanishing the instant its last player stands up.
    "MinTablesPerTier": 3,
    "MinJoinableTablesPerTier": 3,
    "MinEmptyTablesPerTier": 1,
    "EmptyTableGraceSeconds": 120,

    // How much of a tier the table browser receives. A popular tier is dozens of tables and the carousel is not a
    // list, so the lobby sends a curated page: a few FULL tables so the room looks alive, mostly tables with a seat
    // or two free, and always at least one completely empty one for a player who wants a table to themselves.
    "LobbyPageSize": 15,
    "LobbyFullTablesShown": 3,
    "LobbyEmptyTablesShown": 1,
    "TurnSeconds": 15,
    "InsuranceSeconds": 12,
    "BettingSeconds": 15,
    "MaxIdleBettingWindows": 3,
    "PlayableSeats": 3,
    "PresentationPerCardSeconds": 3,
    "MaxPresentationSeconds": 45,
    // DEV CARD RIGS — these OVERWRITE the dealt cards after the deal, so the shoe becomes irrelevant while any of
    // them is on: the dealer's up-card, and/or your hand, are stamped to fixed values keyed off the round counter.
    // Handy for testing peek/insurance/split; leave them OFF or every session deals the same hand.
    "DevRigDealer": false,
    "DevRigDealer1stCardTen": false,
    "DevPlayerRigPair": false,
    "DevRigResplit": false
  },

  "Table": {
    "HeartbeatIntervalSeconds": 5,
    "StalledTimeoutSeconds": 30,
    "DisconnectGraceSeconds": 20
  },

  "Moderation": {
    "AiEnabled": false
  },

  "Firebase": {
