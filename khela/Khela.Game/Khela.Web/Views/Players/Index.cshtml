@using Khela.Common.Leaderboards
@using Khela.Web.Controllers
@model PlayersVm
@{
    ViewData["Title"] = "Player Management";
    ViewData["Crumb"] = "Players";
    ViewData["Nav"] = "players";

    string TierName(VipTier t) => t switch
    {
        VipTier.RoyalDiamond => "Royal Diamond",
        VipTier.BlackDiamond => "Black Diamond",
        _ => t.ToString()
    };
    string Money(long n) => n.ToString("#,0");
}

<h1 class="page-title">Player Management</h1>
<p class="page-sub">Search players, then open a player to set VIP level/tier or grant currency. VIP level is a durable admin grant; tier may re-derive from Status Points on the monthly review.</p>

@if (!string.IsNullOrEmpty(Model.Saved))
{
    <div class="panel" style="border-left:3px solid var(--ok, #34d399); margin-bottom:14px"><div style="padding:12px 16px; color:var(--ok,#34d399)">@Model.Saved</div></div>
}
@if (!string.IsNullOrEmpty(Model.Error))
{
    <div class="panel" style="border-left:3px solid var(--bad, #f87171); margin-bottom:14px"><div style="padding:12px 16px; color:var(--bad,#f87171)">@Model.Error</div></div>
}

<form asp-controller="Players" asp-action="Index" method="get" class="wallet-search">
    <div class="mini-search" style="flex:1; max-width:480px">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7" /><path d="M21 21l-4.3-4.3" /></svg>
        <input type="text" name="q" value="@Model.Query" placeholder="Player name, email, or user id…" autofocus style="width:100%" />
    </div>
    <button class="btn btn-primary" type="submit">Search</button>
    @if (!string.IsNullOrWhiteSpace(Model.Query))
    {
        <a class="btn btn-outline" asp-action="Index">Clear</a>
    }
</form>

<div class="panel">
    <div class="panel-head">
        <h3>Players</h3>
        <span class="dim" style="font-size:12.5px">
            @(string.IsNullOrWhiteSpace(Model.Query) ? "50 most recently active" : $"{Model.Players.Count} match(es)")
        </span>
    </div>
    <table class="data-table">
        <thead>
            <tr>
                <th>Player</th>
                <th>Email</th>
                <th>Level</th>
                <th>Loyalty</th>
                <th>Current VIP</th>
                <th style="width:128px; text-align:right">Manage</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var p in Model.Players)
            {
                <tr>
                    <td>
                        <div>@p.DisplayName</div>
                        <div class="dim" style="font-size:11px">@p.UserId</div>
                    </td>
                    <td class="dim" style="font-size:12px">@(p.Email ?? "—")</td>
                    <td>@p.Level</td>
                    <td>@Money(p.LoyaltyPoints) LP</td>
                    <td>
                        <span class="pill active">@TierName(p.VipTier)</span>
                        <span class="pill @(p.VipLevel > 0 ? "active" : "pending")" style="margin-left:4px">@(p.VipLevel > 0 ? $"VIP {p.VipLevel}" : "no VIP")</span>
                    </td>
                    <td style="text-align:right; white-space:nowrap">
                        <button type="button" class="btn btn-outline btn-icn" title="View details"
                                data-uid="@p.UserId" onclick="openDetailsModal(this)">
                            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4"/><path d="M12 8h.01"/></svg>
                        </button>
                        <button type="button" class="btn btn-outline btn-edit"
                                data-uid="@p.UserId"
                                data-name="@p.DisplayName"
                                data-viplevel="@p.VipLevel"
                                data-viptier="@((int)p.VipTier)"
                                data-status="@TierName(p.VipTier) · @(p.VipLevel > 0 ? $"VIP {p.VipLevel}" : "no VIP") · @Money(p.LoyaltyPoints) LP"
                                onclick="openPlayerModal(this)">
                            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4z"/></svg>
                            Edit
                        </button>
                    </td>
                </tr>
            }
            @if (Model.Players.Count == 0)
            {
                <tr><td colspan="6" class="dim" style="padding:18px 16px">No players@(string.IsNullOrWhiteSpace(Model.Query) ? "." : $" matched “{Model.Query}”.")</td></tr>
            }
        </tbody>
    </table>
</div>

@* ---- Player settings modal (single, shared; populated by JS from the clicked row) ---- *@
<div id="playerModal" class="modal-overlay" aria-hidden="true">
    <div class="modal-card" role="dialog" aria-modal="true" aria-labelledby="pmName">
        <div class="modal-head">
            <div>
                <div id="pmName" class="modal-title">Player</div>
                <div id="pmId" class="dim" style="font-size:11px"></div>
                <div id="pmStatus" class="dim" style="font-size:12px; margin-top:4px"></div>
            </div>
            <button type="button" class="modal-close" onclick="closePlayerModal()" aria-label="Close">&times;</button>
        </div>
        <div class="modal-body">
            <form asp-action="SetVip" method="post" class="modal-section">
                <input type="hidden" name="userId" id="pmVipUserId" />
                <input type="hidden" name="q" value="@Model.Query" />
                <div class="modal-section-title">VIP</div>
                <div class="modal-row">
                    <label>Level</label>
                    <select name="vipLevel" id="pmVipLevel" class="vip-select">
                        @for (int lvl = 0; lvl <= 10; lvl++) { <option value="@lvl">@lvl</option> }
                    </select>
                    <label>Tier</label>
                    <select name="vipTier" id="pmVipTier" class="vip-select">
                        @for (int t = 0; t <= 7; t++) { <option value="@t">@TierName((VipTier)t)</option> }
                    </select>
                    <button class="btn btn-primary" type="submit" style="margin-left:auto">Set VIP</button>
                </div>
            </form>
            <form asp-action="GrantBalance" method="post" class="modal-section">
                <input type="hidden" name="userId" id="pmGrantUserId" />
                <input type="hidden" name="q" value="@Model.Query" />
                <div class="modal-section-title">Grant balance</div>
                <div class="modal-row">
                    <select name="currency" class="vip-select">
                        <option value="Chips">Chips</option>
                        <option value="Coins">Coins</option>
                        <option value="Gems">Gems</option>
                        <option value="Kash">Kash</option>
                        <option value="LP">Loyalty Pts</option>
                    </select>
                    <input type="number" name="amount" min="0" step="any" placeholder="amount" class="vip-select" style="width:120px" />
                    <button class="btn btn-outline" type="submit" style="margin-left:auto">Grant</button>
                </div>
                <div class="dim" style="font-size:11px; margin-top:8px">Chips/Coins/Gems/Kash post through the audited wallet ledger; Loyalty Pts adjust the profile.</div>
            </form>
        </div>
    </div>
</div>

@* ---- Player details modal (read-only; body fetched on demand) ---- *@
<div id="detailsModal" class="modal-overlay" aria-hidden="true">
    <div class="modal-card" style="width:min(840px,96vw)" role="dialog" aria-modal="true">
        <div class="modal-head">
            <div class="modal-title">Player details</div>
            <button type="button" class="modal-close" onclick="closeDetailsModal()" aria-label="Close">&times;</button>
        </div>
        <div class="modal-body" id="dmBody" style="max-height:74vh; overflow:auto; padding-top:14px"></div>
    </div>
</div>

<style>
    .vip-select {
        background: var(--panel-2, #1a2030);
        color: var(--text, #e6e9ef);
        border: 1px solid var(--border, #2a3344);
        border-radius: 7px;
        padding: 5px 8px;
        font-size: 12.5px;
    }
    .btn-edit { padding: 5px 12px; font-size: 12.5px; display: inline-flex; align-items: center; gap: 6px; }
    .btn-icn { padding: 5px 9px; font-size: 12.5px; display: inline-flex; align-items: center; }

    .pd-head { padding-bottom: 12px; margin-bottom: 4px; border-bottom: 1px solid var(--border, #2a3344); }
    .pd-name { font-weight: 600; font-size: 17px; }
    .pd-tags { display: flex; gap: 6px; margin-top: 6px; flex-wrap: wrap; }
    .pd-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; margin-top: 14px; }
    .pd-card { background: var(--panel-2, #1a2030); border: 1px solid var(--border, #2a3344); border-radius: 10px; padding: 13px 15px; }
    .pd-card.pd-wide { grid-column: 1 / -1; }
    .pd-card h4 { margin: 0 0 9px; font-size: 11px; text-transform: uppercase; letter-spacing: .05em; color: var(--muted, #8a93a6); }
    .pd-kv { display: flex; justify-content: space-between; gap: 12px; padding: 5px 0; font-size: 13px; border-bottom: 1px dashed rgba(255,255,255,.06); }
    .pd-kv:last-child { border-bottom: none; }
    .pd-kv > span { color: var(--muted, #8a93a6); white-space: nowrap; }
    .pd-kv > b { text-align: right; word-break: break-word; font-weight: 600; }
    .pd-stats { display: grid; grid-template-columns: repeat(4, 1fr); gap: 10px; }
    .pd-stat { background: var(--panel, #131a2a); border: 1px solid var(--border, #2a3344); border-radius: 8px; padding: 10px; text-align: center; }
    .pd-stat-v { font-weight: 700; font-size: 15px; }
    .pd-stat-l { font-size: 10.5px; text-transform: uppercase; letter-spacing: .04em; color: var(--muted, #8a93a6); margin-top: 3px; }
    .pg-tabs { display: flex; gap: 4px; flex-wrap: wrap; border-bottom: 1px solid var(--border, #2a3344); margin-bottom: 12px; }
    .pg-tab { background: none; border: none; color: var(--muted, #8a93a6); padding: 7px 12px; font-size: 12.5px; cursor: pointer; border-bottom: 2px solid transparent; margin-bottom: -1px; }
    .pg-tab:hover { color: var(--text, #e6e9ef); }
    .pg-tab.active { color: var(--text, #e6e9ef); border-bottom-color: var(--accent, #6d7cff); font-weight: 600; }
    .pg-sub { font-size: 10.5px; text-transform: uppercase; letter-spacing: .05em; color: var(--muted, #8a93a6); margin: 14px 0 8px; }
    .pg-counters { display: grid; grid-template-columns: repeat(2, 1fr); gap: 2px 18px; }
    .pg-counters .pd-kv { font-size: 12.5px; }
    @@media (max-width: 640px) { .pd-grid, .pd-stats { grid-template-columns: 1fr 1fr; } .pg-counters { grid-template-columns: 1fr; } }

    .modal-overlay {
        position: fixed; inset: 0; background: rgba(2, 6, 16, .62);
        display: none; align-items: center; justify-content: center; z-index: 1000; padding: 20px;
    }
    .modal-overlay.open { display: flex; }
    .modal-card {
        background: var(--panel, #131a2a); border: 1px solid var(--border, #2a3344);
        border-radius: 14px; width: min(560px, 94vw); box-shadow: 0 24px 70px rgba(0, 0, 0, .55); overflow: hidden;
    }
    .modal-head {
        display: flex; justify-content: space-between; align-items: flex-start;
        padding: 16px 18px; border-bottom: 1px solid var(--border, #2a3344);
    }
    .modal-title { font-weight: 600; font-size: 16px; }
    .modal-close { background: none; border: none; color: var(--text, #e6e9ef); font-size: 24px; cursor: pointer; line-height: 1; }
    .modal-body { padding: 6px 18px 18px; }
    .modal-section { padding: 14px 0; }
    .modal-section + .modal-section { border-top: 1px solid var(--border, #2a3344); }
    .modal-section-title { font-size: 11px; text-transform: uppercase; letter-spacing: .05em; color: var(--muted, #8a93a6); margin-bottom: 10px; }
    .modal-row { display: flex; gap: 8px; align-items: center; flex-wrap: wrap; }
    .modal-row label { font-size: 12px; color: var(--muted, #8a93a6); }
</style>

<script>
    function openPlayerModal(btn) {
        var d = btn.dataset;
        document.getElementById('pmName').textContent = d.name || 'Player';
        document.getElementById('pmId').textContent = d.uid || '';
        document.getElementById('pmStatus').textContent = d.status || '';
        document.getElementById('pmVipUserId').value = d.uid || '';
        document.getElementById('pmGrantUserId').value = d.uid || '';
        document.getElementById('pmVipLevel').value = d.viplevel || '0';
        document.getElementById('pmVipTier').value = d.viptier || '0';
        document.getElementById('playerModal').classList.add('open');
    }
    function closePlayerModal() {
        document.getElementById('playerModal').classList.remove('open');
    }

    async function openDetailsModal(btn) {
        var uid = btn.dataset.uid;
        var body = document.getElementById('dmBody');
        body.innerHTML = '<div class="dim" style="padding:28px; text-align:center">Loading…</div>';
        document.getElementById('detailsModal').classList.add('open');
        try {
            var r = await fetch('@Url.Action("Details", "Players")' + '?id=' + encodeURIComponent(uid));
            body.innerHTML = r.ok ? await r.text()
                : '<div class="dim" style="padding:28px; text-align:center">Failed to load (' + r.status + ').</div>';
        } catch (e) {
            body.innerHTML = '<div class="dim" style="padding:28px; text-align:center">Error loading details.</div>';
        }
    }
    function closeDetailsModal() { document.getElementById('detailsModal').classList.remove('open'); }

    // Per-game stats tabs inside the details modal (All + one per game).
    function pgTab(btn) {
        var section = btn.closest('section');
        if (!section) return;
        section.querySelectorAll('.pg-tab').forEach(function (t) { t.classList.remove('active'); });
        btn.classList.add('active');
        var tab = btn.dataset.tab;
        section.querySelectorAll('.pg-panel').forEach(function (p) { p.style.display = (p.dataset.tab === tab ? '' : 'none'); });
    }

    // Close any open modal on backdrop click or Esc.
    document.querySelectorAll('.modal-overlay').forEach(function (ov) {
        ov.addEventListener('click', function (e) { if (e.target === this) this.classList.remove('open'); });
    });
    document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape') document.querySelectorAll('.modal-overlay.open').forEach(function (m) { m.classList.remove('open'); });
    });
</script>
