@{
    var nav = ViewData["Nav"] as string ?? "dashboard";
    string On(string key) => nav == key ? "nav-item active" : "nav-item";
    var who = User.Identity?.Name ?? "Admin";
    var initials = (who.Length > 0 ? who.Substring(0, 1) : "A").ToUpperInvariant();
}
<aside class="sidebar">
    <div class="brand">
        <div class="brand-logo">K</div>
        <div>
            <div class="brand-name">Khela</div>
            <div class="brand-sub">Admin Console</div>
        </div>
    </div>

    <nav class="nav">
        <div class="nav-label">Overview</div>

        <a class="@On("dashboard")" asp-controller="Home" asp-action="Index">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/></svg>
            <span>Dashboard</span>
        </a>
        <a class="@On("players")" asp-controller="Players" asp-action="Index">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
            <span>Players</span>
        </a>
        <a class="@On("wallets")" asp-controller="Wallets" asp-action="Index">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12V7H5a2 2 0 0 1 0-4h14v4"/><path d="M3 5v14a2 2 0 0 0 2 2h16v-5"/><path d="M18 12a2 2 0 0 0 0 4h4v-4z"/></svg>
            <span>Wallets &amp; Ledger</span>
        </a>
        <a class="@On("leaderboards")" asp-controller="Home" asp-action="Soon" asp-route-section="leaderboards">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d="M8 21h8M12 17v4M7 4h10v4a5 5 0 0 1-10 0V4zM7 7H4V5a1 1 0 0 1 1-1h2M17 7h3V5a1 1 0 0 0-1-1h-2"/></svg>
            <span>Leaderboards</span>
        </a>

        <div class="nav-label">Operations</div>

        <a class="@On("tables")" asp-controller="Home" asp-action="Soon" asp-route-section="tables">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18M9 21V9"/></svg>
            <span>Game Tables</span>
        </a>
        <a class="@On("reports")" asp-controller="Home" asp-action="Soon" asp-route-section="reports">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6M9 13h6M9 17h6"/></svg>
            <span>Reports</span>
            <span class="nav-badge">3</span>
        </a>
        <a class="@On("settings")" asp-controller="Settings" asp-action="Index">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
            <span>Settings</span>
        </a>
        <a class="@On("missions")" asp-controller="Missions" asp-action="Index">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg>
            <span>Missions</span>
        </a>
        <a class="@On("chests")" asp-controller="Chests" asp-action="Index">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d="M3 8l1.6-3.2A1 1 0 0 1 5.5 4h13a1 1 0 0 1 .9.8L21 8M3 8h18v11a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V8zM12 8v12M9.5 12h5"/></svg>
            <span>Chests</span>
        </a>
    </nav>

    <div class="sidebar-spacer"></div>

    <div class="sidebar-user">
        <div class="avatar">@initials</div>
        <div class="who">
            <div class="nm">@who</div>
            <div class="rl">Administrator</div>
        </div>
        <form asp-controller="Account" asp-action="Logout" method="post">
            <button type="submit" class="logout-btn" title="Sign out">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4M16 17l5-5-5-5M21 12H9"/></svg>
            </button>
        </form>
    </div>
</aside>
