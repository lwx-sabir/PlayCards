<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · Khela Admin</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <script src="~/js/theme-switcher.js" asp-append-version="true"></script>
</head>
<body>
    <div class="app-shell">
        @await Html.PartialAsync("_Sidebar")
        <div class="app-main">
            <header class="topbar">
                <nav class="crumb">
                    <span>Admin</span>
                    <span class="sep">›</span>
                    <span class="cur">@(ViewData["Crumb"] ?? ViewData["Title"] ?? "Dashboard")</span>
                </nav>
                <div class="topbar-search">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4.3-4.3"/></svg>
                    <input type="text" placeholder="Search players, tables, transactions…" />
                </div>
                <div class="topbar-actions">
                    <button class="icon-btn" title="Notifications">
                        <span class="dot"></span>
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" width="18" height="18"><path d="M18 8a6 6 0 0 0-12 0c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.7 21a2 2 0 0 1-3.4 0"/></svg>
                    </button>
                    <button class="btn btn-primary">
                        New Alert
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="15" height="15"><path d="M7 17L17 7M9 7h8v8"/></svg>
                    </button>
                </div>
            </header>
            <main class="content">
                @RenderBody()
            </main>
        </div>
    </div>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
