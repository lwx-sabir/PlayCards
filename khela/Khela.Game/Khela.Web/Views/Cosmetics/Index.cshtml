@using Khela.Web.Controllers
@model CosmeticsVm
@{
    ViewData["Title"] = "Cosmetics";
    ViewData["Crumb"] = "Cosmetics";
    ViewData["Nav"] = "cosmetics";

    string TypeFilterUrl(string t) => Url.Action("Index", new { q = Model.Query, type = t });
    bool TypeActive(string t) => string.Equals(Model.TypeFilter ?? "", t ?? "", StringComparison.OrdinalIgnoreCase);
    string Money(decimal d) => d == Math.Floor(d) ? ((long)d).ToString("#,0") : d.ToString("#,0.##");
    string[] currencies = { "Coins", "Gems", "Kash", "Chips" };
}

<h1 class="page-title">Cosmetics</h1>
<p class="page-sub">The clothing &amp; character catalog players buy in the shop. SKUs and their baked icons come from the Unity Cosmetic Exporter; tune price, currency, availability, and metadata here. Edits are live — no redeploy.</p>

@if (!string.IsNullOrEmpty(Model.Saved))
{
    <div class="panel" style="border-left:3px solid var(--ok,#34d399); margin-bottom:14px"><div style="padding:12px 16px; color:var(--ok,#34d399)">@Model.Saved</div></div>
}
@if (!string.IsNullOrEmpty(Model.Error))
{
    <div class="panel" style="border-left:3px solid var(--bad,#f87171); margin-bottom:14px"><div style="padding:12px 16px; color:var(--bad,#f87171)">@Model.Error</div></div>
}

<div class="cos-stats">
    <div class="cos-stat"><div class="v">@Model.Total</div><div class="l">Total SKUs</div></div>
    <div class="cos-stat"><div class="v">@Model.EnabledCount</div><div class="l">Enabled</div></div>
    <div class="cos-stat"><div class="v">@Model.ItemCount</div><div class="l">Items</div></div>
    <div class="cos-stat"><div class="v">@Model.SetCount</div><div class="l">Sets</div></div>
    <div class="cos-stat"><div class="v">@Model.CharacterCount</div><div class="l">Characters</div></div>
    <div class="cos-stat @(Model.MissingIconCount > 0 ? "warn" : "")"><div class="v">@Model.MissingIconCount</div><div class="l">Missing icon</div></div>
</div>

<div class="cos-toolbar">
    <form asp-action="Index" method="get" class="wallet-search" style="margin:0; flex:1">
        <div class="mini-search" style="flex:1; max-width:420px">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4.3-4.3"/></svg>
            <input type="text" name="q" value="@Model.Query" placeholder="Name, id, or mesh path…" style="width:100%" />
        </div>
        <input type="hidden" name="type" value="@Model.TypeFilter" />
        <button class="btn btn-primary" type="submit">Search</button>
    </form>
    <div class="cos-pills">
        <a class="pill @(TypeActive("") ? "active" : "")" href="@TypeFilterUrl("")">All</a>
        <a class="pill @(TypeActive("Item") ? "active" : "")" href="@TypeFilterUrl("Item")">Items</a>
        <a class="pill @(TypeActive("Set") ? "active" : "")" href="@TypeFilterUrl("Set")">Sets</a>
        <a class="pill @(TypeActive("Character") ? "active" : "")" href="@TypeFilterUrl("Character")">Characters</a>
    </div>
</div>

@if (Model.Items.Count == 0)
{
    <div class="panel"><div class="dim" style="padding:22px 16px">No cosmetics@(string.IsNullOrWhiteSpace(Model.Query) ? " yet — export some from the Unity Cosmetic Exporter and upload." : $" matched “{Model.Query}”.")</div></div>
}
else
{
    <div class="cos-grid">
        @foreach (var c in Model.Items)
        {
            <div class="cos-card @(c.Enabled ? "" : "disabled")">
                <div class="cos-thumb">
                    @if (c.HasIcon)
                    {
                        <img src="@Url.Action("Icon", new { id = c.Id, v = c.IconVersion })" alt="@c.Name" loading="lazy" />
                    }
                    else
                    {
                        <div class="cos-noimg">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="M21 15l-5-5L5 21"/></svg>
                            <span>no icon</span>
                        </div>
                    }
                    <span class="cos-type cos-type-@c.Type.ToLower()">@c.Type</span>
                    @if (!c.Enabled)
                    {
                        <span class="cos-off">disabled</span>
                    }
                </div>

                <div class="cos-body">
                    <div class="cos-name" title="@c.Name">@c.Name</div>
                    <div class="cos-id" title="@c.Path">@c.Id</div>
                    <div class="cos-sum">@c.Summary</div>

                    <div class="cos-tags">
                        @if (c.Gender != "Unisex")
                        {
                            <span class="pill @(c.Gender == "Female" ? "pill-f" : "pill-m")">@c.Gender</span>
                        }
                        else
                        {
                            <span class="pill">Unisex</span>
                        }
                        @if (c.IsExclusive)
                        {
                            <span class="pill pill-x">Exclusive</span>
                        }
                        @if (c.IsStarter)
                        {
                            <span class="pill active">Starter</span>
                        }
                    </div>

                    <div class="cos-price">
                        @if (c.IsFree)
                        {
                            <span class="cos-free">Free</span>
                        }
                        else
                        {
                            <span class="cos-amt">@Money(c.Price)</span><span class="cos-cur">@c.Currency</span>
                        }
                    </div>
                </div>

                <div class="cos-foot">
                    <button type="button" class="btn btn-outline btn-sm"
                            data-id="@c.Id" data-name="@c.Name" data-desc="@c.Description"
                            data-type="@c.Type" data-gender="@c.Gender" data-price="@c.Price.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                            data-currency="@c.Currency" data-starter="@c.IsStarter.ToString().ToLower()"
                            data-exclusive="@c.IsExclusive.ToString().ToLower()" data-enabled="@c.Enabled.ToString().ToLower()"
                            data-sort="@c.SortOrder" data-slot="@c.Slot" data-path="@c.Path"
                            data-hasicon="@c.HasIcon.ToString().ToLower()"
                            onclick="openEdit(this)">
                        <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4z"/></svg>
                        Edit
                    </button>
                    <form asp-action="Toggle" method="post" style="display:inline">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@c.Id" />
                        <input type="hidden" name="q" value="@Model.Query" />
                        <input type="hidden" name="type" value="@Model.TypeFilter" />
                        <button type="submit" class="btn btn-outline btn-sm" title="@(c.Enabled ? "Disable (hide from shop)" : "Enable")">
                            @(c.Enabled ? "Disable" : "Enable")
                        </button>
                    </form>
                </div>
            </div>
        }
    </div>
}

@* ---- Edit modal (shared; populated by JS from the clicked card) ---- *@
<div id="editModal" class="modal-overlay" aria-hidden="true">
    <div class="modal-card" role="dialog" aria-modal="true" aria-labelledby="emTitle">
        <div class="modal-head">
            <div>
                <div id="emTitle" class="modal-title">Edit cosmetic</div>
                <div id="emId" class="dim" style="font-size:11px"></div>
                <div id="emMeta" class="dim" style="font-size:11.5px; margin-top:4px"></div>
            </div>
            <button type="button" class="modal-close" onclick="closeEdit()" aria-label="Close">&times;</button>
        </div>
        <div class="modal-body">
            <form asp-action="Save" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" id="emIdField" />
                <input type="hidden" name="q" value="@Model.Query" />
                <input type="hidden" name="type" value="@Model.TypeFilter" />

                <div class="em-field">
                    <label>Display name</label>
                    <input type="text" name="name" id="emName" class="em-input" maxlength="100" />
                </div>
                <div class="em-field">
                    <label>Description</label>
                    <textarea name="description" id="emDesc" class="em-input" rows="2" maxlength="500"></textarea>
                </div>

                <div class="em-row">
                    <div class="em-field" style="flex:1">
                        <label>Price</label>
                        <input type="number" name="price" id="emPrice" class="em-input" min="0" step="any" />
                    </div>
                    <div class="em-field" style="flex:1">
                        <label>Currency</label>
                        <select name="priceCurrency" id="emCurrency" class="em-input">
                            @foreach (var cur in currencies)
                            {
                                <option value="@cur">@cur</option>
                            }
                        </select>
                    </div>
                    <div class="em-field" id="emGenderField" style="flex:1">
                        <label>Gender</label>
                        <select name="gender" id="emGender" class="em-input">
                            <option value="">Unisex</option>
                            <option value="Male">Male</option>
                            <option value="Female">Female</option>
                        </select>
                    </div>
                </div>

                <div class="em-row" style="align-items:center; gap:18px; margin-top:4px">
                    <label class="em-check"><input type="checkbox" name="enabled" id="emEnabled" value="true" /> Enabled</label>
                    <label class="em-check"><input type="checkbox" name="isStarter" id="emStarter" value="true" /> Starter (free)</label>
                    <label class="em-check"><input type="checkbox" name="isExclusive" id="emExclusive" value="true" /> Exclusive</label>
                    <div class="em-field" style="margin-left:auto; width:96px">
                        <label>Sort order</label>
                        <input type="number" name="sortOrder" id="emSort" class="em-input" step="1" />
                    </div>
                </div>
                @* unchecked checkboxes post nothing → send an explicit false so they can be turned OFF *@
                <input type="hidden" name="enabled" value="false" />
                <input type="hidden" name="isStarter" value="false" />
                <input type="hidden" name="isExclusive" value="false" />

                <div class="em-actions">
                    <button type="submit" class="btn btn-primary">Save changes</button>
                    <span style="flex:1"></span>
                    <button type="button" class="btn btn-outline" onclick="deleteSku()" style="color:var(--bad,#f87171); border-color:var(--bad,#f87171)">Delete</button>
                </div>
            </form>

            <form asp-action="Delete" method="post" id="emDeleteForm" style="display:none">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" id="emDeleteId" />
                <input type="hidden" name="q" value="@Model.Query" />
                <input type="hidden" name="type" value="@Model.TypeFilter" />
            </form>

            @* ---- icon art: download for external editing, re-upload the edited PNG ---- *@
            <div class="em-icon-section">
                <div class="em-field" style="margin-bottom:8px"><label>Icon art</label></div>
                <div class="em-row" style="align-items:center">
                    <a id="emDownload" class="btn btn-outline btn-sm" href="#" style="display:none">
                        <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><path d="M7 10l5 5 5-5"/><path d="M12 15V3"/></svg>
                        Download PNG
                    </a>
                    <span id="emNoIcon" class="dim" style="font-size:12px; display:none">No icon yet — bake one from the Unity exporter or upload a PNG.</span>
                    <form asp-action="UploadIcon" method="post" enctype="multipart/form-data" style="display:flex; gap:8px; align-items:center; margin-left:auto">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" id="emIconId" />
                        <input type="hidden" name="q" value="@Model.Query" />
                        <input type="hidden" name="type" value="@Model.TypeFilter" />
                        <input type="file" name="icon" accept="image/png" required style="font-size:12px; max-width:210px" />
                        <button type="submit" class="btn btn-outline btn-sm">Replace icon</button>
                    </form>
                </div>
                <div class="dim" style="font-size:11px; margin-top:6px">PNG only, max 2MB. Transparent background recommended (the shop renders it on its own backdrop).</div>
            </div>
        </div>
    </div>
</div>

<style>
    .cos-stats { display:grid; grid-template-columns:repeat(6,1fr); gap:10px; margin-bottom:16px; }
    .cos-stat { background:var(--panel,#131a2a); border:1px solid var(--border,#2a3344); border-radius:10px; padding:12px 14px; }
    .cos-stat .v { font-weight:700; font-size:20px; }
    .cos-stat .l { font-size:10.5px; text-transform:uppercase; letter-spacing:.04em; color:var(--muted,#8a93a6); margin-top:2px; }
    .cos-stat.warn .v { color:var(--warn,#fbbf24); }

    .cos-toolbar { display:flex; gap:14px; align-items:center; margin-bottom:16px; flex-wrap:wrap; }
    .cos-pills { display:flex; gap:6px; flex-wrap:wrap; }
    .cos-pills .pill { text-decoration:none; cursor:pointer; }

    .cos-grid { display:grid; grid-template-columns:repeat(auto-fill,minmax(212px,1fr)); gap:14px; }
    .cos-card { background:var(--panel,#131a2a); border:1px solid var(--border,#2a3344); border-radius:12px; overflow:hidden; display:flex; flex-direction:column; transition:border-color .12s, transform .12s; }
    .cos-card:hover { border-color:var(--accent,#6d7cff); transform:translateY(-2px); }
    .cos-card.disabled { opacity:.62; }

    .cos-thumb { position:relative; aspect-ratio:1/1; background:
        linear-gradient(45deg,#232a3a 25%,transparent 25%),linear-gradient(-45deg,#232a3a 25%,transparent 25%),
        linear-gradient(45deg,transparent 75%,#232a3a 75%),linear-gradient(-45deg,transparent 75%,#232a3a 75%);
        background-size:18px 18px; background-position:0 0,0 9px,9px -9px,-9px 0; background-color:#1a2030; }
    .cos-thumb img { width:100%; height:100%; object-fit:contain; display:block; }
    .cos-noimg { position:absolute; inset:0; display:flex; flex-direction:column; align-items:center; justify-content:center; gap:6px; color:var(--muted,#8a93a6); }
    .cos-noimg svg { width:34px; height:34px; }
    .cos-noimg span { font-size:11px; }
    .cos-type { position:absolute; top:8px; left:8px; font-size:10px; font-weight:600; text-transform:uppercase; letter-spacing:.04em; padding:3px 7px; border-radius:6px; background:rgba(10,14,24,.8); color:#cdd4e2; backdrop-filter:blur(4px); }
    .cos-type-item { color:#93c5fd; } .cos-type-set { color:#c4b5fd; } .cos-type-character { color:#6ee7b7; }
    .cos-off { position:absolute; top:8px; right:8px; font-size:10px; font-weight:600; text-transform:uppercase; padding:3px 7px; border-radius:6px; background:rgba(248,113,113,.16); color:var(--bad,#f87171); }

    .cos-body { padding:11px 13px 4px; flex:1; }
    .cos-name { font-weight:600; font-size:14px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
    .cos-id { font-size:11px; color:var(--muted,#8a93a6); font-family:ui-monospace,monospace; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; margin-top:1px; }
    .cos-sum { font-size:11.5px; color:var(--muted,#8a93a6); margin-top:5px; }
    .cos-tags { display:flex; gap:5px; flex-wrap:wrap; margin-top:9px; }
    .cos-price { margin-top:10px; display:flex; align-items:baseline; gap:5px; }
    .cos-amt { font-weight:700; font-size:16px; }
    .cos-cur { font-size:11px; color:var(--muted,#8a93a6); text-transform:uppercase; letter-spacing:.03em; }
    .cos-free { font-weight:700; font-size:14px; color:var(--ok,#34d399); }

    .cos-foot { display:flex; gap:7px; padding:11px 13px; border-top:1px solid var(--border,#2a3344); }
    .cos-foot .btn { flex:1; justify-content:center; }
    .btn-sm { padding:5px 10px; font-size:12px; display:inline-flex; align-items:center; gap:5px; }

    .pill-m { background:rgba(59,130,246,.16); color:#93c5fd; }
    .pill-f { background:rgba(236,72,153,.16); color:#f9a8d4; }
    .pill-x { background:rgba(251,191,36,.16); color:#fcd34d; }

    .em-field { margin-bottom:12px; }
    .em-field label { display:block; font-size:11px; text-transform:uppercase; letter-spacing:.04em; color:var(--muted,#8a93a6); margin-bottom:5px; }
    .em-input { width:100%; background:var(--panel-2,#1a2030); color:var(--text,#e6e9ef); border:1px solid var(--border,#2a3344); border-radius:7px; padding:7px 9px; font-size:13px; box-sizing:border-box; }
    textarea.em-input { resize:vertical; font-family:inherit; }
    .em-row { display:flex; gap:12px; }
    .em-check { display:flex; align-items:center; gap:6px; font-size:12.5px; color:var(--text,#e6e9ef); cursor:pointer; }
    .em-actions { display:flex; align-items:center; gap:10px; margin-top:16px; padding-top:14px; border-top:1px solid var(--border,#2a3344); }
    .em-icon-section { margin-top:16px; padding-top:14px; border-top:1px solid var(--border,#2a3344); }
    .em-icon-section .btn-sm { display:inline-flex; align-items:center; gap:6px; text-decoration:none; }

    .modal-overlay { position:fixed; inset:0; background:rgba(2,6,16,.62); display:none; align-items:center; justify-content:center; z-index:1000; padding:20px; }
    .modal-overlay.open { display:flex; }
    .modal-card { background:var(--panel,#131a2a); border:1px solid var(--border,#2a3344); border-radius:14px; width:min(560px,94vw); box-shadow:0 24px 70px rgba(0,0,0,.55); overflow:hidden; }
    .modal-head { display:flex; justify-content:space-between; align-items:flex-start; padding:16px 18px; border-bottom:1px solid var(--border,#2a3344); }
    .modal-title { font-weight:600; font-size:16px; }
    .modal-close { background:none; border:none; color:var(--text,#e6e9ef); font-size:24px; cursor:pointer; line-height:1; }
    .modal-body { padding:16px 18px 18px; }

    @@media (max-width:820px) { .cos-stats { grid-template-columns:repeat(3,1fr); } }
</style>

<script>
    function openEdit(btn) {
        var d = btn.dataset;
        document.getElementById('emTitle').textContent = 'Edit — ' + (d.name || '');
        document.getElementById('emId').textContent = d.id;
        document.getElementById('emMeta').textContent = d.type + (d.path ? ' · ' + d.path : '') + (d.slot ? ' · ' + d.slot : '');
        document.getElementById('emIdField').value = d.id;
        document.getElementById('emDeleteId').value = d.id;
        document.getElementById('emName').value = d.name || '';
        document.getElementById('emDesc').value = d.desc || '';
        document.getElementById('emPrice').value = d.price || '0';
        document.getElementById('emCurrency').value = d.currency || 'Kash';
        document.getElementById('emGender').value = (d.gender === 'Unisex' ? '' : d.gender) || '';
        document.getElementById('emSort').value = d.sort || '0';
        document.getElementById('emEnabled').checked = d.enabled === 'true';
        document.getElementById('emStarter').checked = d.starter === 'true';
        document.getElementById('emExclusive').checked = d.exclusive === 'true';
        // Character gender is derived from its payload — lock the control for those.
        document.getElementById('emGenderField').style.display = (d.type === 'Character') ? 'none' : '';
        // Icon art: download link (only when an icon exists) + the re-upload form's target id.
        document.getElementById('emIconId').value = d.id;
        var hasIcon = d.hasicon === 'true';
        var dl = document.getElementById('emDownload');
        dl.style.display = hasIcon ? '' : 'none';
        dl.href = '@Url.Action("Icon")' + '?id=' + encodeURIComponent(d.id) + '&download=true';
        document.getElementById('emNoIcon').style.display = hasIcon ? 'none' : '';
        document.getElementById('editModal').classList.add('open');
    }
    function closeEdit() { document.getElementById('editModal').classList.remove('open'); }
    function deleteSku() {
        var name = document.getElementById('emName').value;
        if (confirm('Delete “' + name + '”? This is blocked if any player already owns it.')) {
            document.getElementById('emDeleteForm').submit();
        }
    }
    document.querySelectorAll('.modal-overlay').forEach(function (ov) {
        ov.addEventListener('click', function (e) { if (e.target === this) this.classList.remove('open'); });
    });
    document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape') document.querySelectorAll('.modal-overlay.open').forEach(function (m) { m.classList.remove('open'); });
    });
</script>
