@model Khela.Web.Controllers.SettingsVm
@{
    ViewData["Title"] = "Settings";
    ViewData["Crumb"] = "Settings";
    ViewData["Nav"] = "settings";
}

<h1 class="page-title">Settings</h1>
<p class="page-sub">Casino-wide and per-game configuration.</p>

@if (!string.IsNullOrEmpty(Model.Saved)) { <div class="banner ok">@Model.Saved</div> }
@if (!string.IsNullOrEmpty(Model.Error)) { <div class="banner err">@Model.Error</div> }

<div class="tabs">
    <button type="button" class="tab active" data-tab="casino">Casino Settings</button>
    <button type="button" class="tab" data-tab="game">Game Settings</button>
    <button type="button" class="tab" data-tab="piggy">Piggy Bank</button>
    <button type="button" class="tab" data-tab="viployalty">VIP &amp; Loyalty</button>
    <button type="button" class="tab" data-tab="store">Store</button>
    <button type="button" class="tab" data-tab="transfer">Transfer</button>
</div>

<div class="tab-panel" data-panel="casino">
    <div class="panel">
        <div class="panel-head">
            <h3>Economy &amp; progression</h3>
            <span class="badge badge-live">Live · applies next round</span>
        </div>
        <form asp-controller="Settings" asp-action="SaveCasino" method="post">
            <div class="setting-list">
                @foreach (var s in Model.Casino)
                {
                    <div class="setting-edit-row2">
                        <div class="setting-meta">
                            <div class="setting-label">@s.Label</div>
                            <div class="setting-help">@s.Help</div>
                        </div>
                        <input class="input setting-input" type="number" step="@s.Step" name="@s.Key" value="@s.Value" />
                    </div>
                }
            </div>
            <div style="margin-top:18px"><button class="btn btn-primary" type="submit">Save casino settings</button></div>
        </form>
    </div>
</div>

<div class="tab-panel hidden" data-panel="game">
    <div class="panel">
        <div class="panel-head">
            <h3>Blackjack &amp; table timing</h3>
            <span class="badge badge-live">Live · within ~15s</span>
        </div>
        <p class="page-sub" style="margin-top:0">
            Moved next to the tables they govern — round timing, shoe, lobby balancer floors, presentation and
            connection knobs, plus the stake-tier ladder, now live on
            <a asp-controller="Tables" asp-action="Index" asp-route-tab="settings"><b>Game Tables → Table Settings</b></a>.
            One editor, one source of truth; the same <code>khela:settings</code> overlay underneath.
        </p>

        @if (Model.GameReadOnly.Count > 0)
        {
            <div class="setting-list" style="margin-top:18px">
                @foreach (var s in Model.GameReadOnly)
                {
                    <div class="setting-row">
                        <span class="setting-label">@s.Label</span>
                        <span class="setting-val">@s.Value</span>
                        <span class="badge badge-plan">appsettings · restart</span>
                    </div>
                }
            </div>
        }
    </div>
</div>

<div class="tab-panel hidden" data-panel="piggy">
    <div class="panel">
        <div class="panel-head">
            <h3>Piggy bank</h3>
            <span class="badge badge-live">Live · applies next round</span>
        </div>

        <p class="page-sub" style="margin-top:0">
            A chip pack whose <strong>unlock is paced by play</strong>: it fills as the player wagers and is released
            only by paying. Accruing mints nothing, so these rates decide how often a full bank appears — not what it
            costs you. The bank ladder (capacity per level) lives in code; see <code>docs/PIGGY_BANK_SPEC.md</code>.
        </p>

        <form asp-controller="Settings" asp-action="SavePiggy" method="post">
            <div class="setting-list">
                <div class="setting-edit-row2">
                    <div class="setting-meta">
                        <div class="setting-label">Enabled</div>
                        <div class="setting-help">Off hides the bank and stops all accrual. Ships off.</div>
                    </div>
                    <input class="setting-input" type="checkbox" name="Piggy:Enabled" value="on" @(Model.PiggyEnabled ? "checked" : "") />
                </div>

                <div class="setting-edit-row2">
                    <div class="setting-meta">
                        <div class="setting-label">Fills from</div>
                        <div class="setting-help">
                            <strong>Wager</strong> banks a share of every stake — predictable, and independent of luck.
                            <strong>Loss</strong> banks a share of losing rounds, which fills far faster than the house
                            actually wins and makes fill time a lottery. Wager unless you have a reason.
                        </div>
                    </div>
                    <select class="input setting-input" name="Piggy:Mode">
                        <option value="Wager" selected="@(Model.PiggyMode == "Wager")">Wager</option>
                        <option value="Loss" selected="@(Model.PiggyMode == "Loss")">Loss</option>
                        <option value="Both" selected="@(Model.PiggyMode == "Both")">Both</option>
                    </select>
                </div>

                @foreach (var s in Model.Piggy)
                {
                    <div class="setting-edit-row2">
                        <div class="setting-meta">
                            <div class="setting-label">@s.Label</div>
                            <div class="setting-help">@s.Help</div>
                        </div>
                        <input class="input setting-input" type="number" step="@s.Step" min="@s.Min" name="@s.Key" value="@s.Value" />
                    </div>
                }
                <div class="setting-edit-row2">
                    <div class="setting-meta">
                        <div class="setting-label">⚠️ Break without purchase (dev)</div>
                        <div class="setting-help">
                            Lets a full bank be opened with no verified purchase. <strong>Must be off in production</strong> —
                            a free break is the one thing that turns this feature into a chip faucet. Same rule as
                            <code>Rewards:BypassAdForMissedDays</code>.
                        </div>
                    </div>
                    <input class="setting-input" type="checkbox" name="Piggy:BypassPurchase" value="on" @(Model.PiggyBypassPurchase ? "checked" : "") />
                </div>
            </div>

            <div style="margin-top:18px"><button class="btn btn-primary" type="submit">Save piggy settings</button></div>
        </form>
    </div>

    <div class="panel" style="margin-top:18px">
        <div class="panel-head">
            <h3>Bank tiers</h3>
            <span class="badge badge-live">Live · next bank</span>
        </div>

        <p class="page-sub" style="margin-top:0">
            How big the bank is, by player level. A player gets the highest rung they qualify for — so higher tiers
            give a <strong>bigger</strong> bank, never a faster one; speed is the wager rate and the daily cap above.
        </p>
        <p class="page-sub">
            ⚠️ Capacity is <strong>snapshotted onto each player's bank</strong> when it opens. Changing a tier does not
            resize a bank that already exists — otherwise lowering one would strand players mid-fill and raising one
            would un-fill banks that were full a second earlier. On a test account use
            <strong>Testing → Empty it</strong> to pick up a new size.
        </p>

        <form asp-controller="Settings" asp-action="SavePiggyTiers" method="post">
            <table class="table" id="tierTable" style="width:100%; margin-top:8px">
                <thead>
                    <tr>
                        <th style="text-align:left">Min level</th>
                        <th style="text-align:left">Max amount (chips)</th>
                        <th style="text-align:left">Price SKU (optional)</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var tier in Model.PiggyTiers)
                    {
                        <tr>
                            <td><input class="input" type="number" min="1" step="1" name="tierMinLevel" value="@tier.MinLevel" style="width:120px" /></td>
                            <td><input class="input" type="number" min="0" step="1000" name="tierMaxAmount" value="@tier.MaxAmount" style="width:200px" /></td>
                            <td><input class="input" type="text" name="tierSku" value="@tier.PriceSku" placeholder="piggy_tier1" style="width:220px" /></td>
                            <td><button type="button" class="btn" onclick="this.closest('tr').remove()">Remove</button></td>
                        </tr>
                    }
                </tbody>
            </table>

            <div style="margin-top:14px; display:flex; gap:10px; flex-wrap:wrap">
                <button type="button" class="btn" id="addTier">+ Add tier</button>
                <button class="btn btn-primary" type="submit">Save tiers</button>
            </div>
        </form>

        <p class="page-sub" style="margin-top:14px">
            A row saved with <strong>no amount</strong> is dropped, which is also how you delete one. Saving an empty
            table is refused — a bank with no capacity can never fill and reads as broken. To go back to the built-in
            ladder, delete <code>Piggy:Tiers</code> from Redis.
        </p>
    </div>
</div>

<div class="tab-panel hidden" data-panel="viployalty">
    <div class="panel">
        <div class="panel-head">
            <h3>VIP &amp; Loyalty</h3>
            <span class="badge badge-live">Live · next accrual</span>
        </div>
        <p class="page-sub" style="margin-top:0">
            Status Points (the VIP ladder) and Loyalty Points (the chip comp). Every scalar the two services read live
            from the overlay is here; an <b>empty box means the code default</b> (shown in each description). The
            per-tier arrays — SP thresholds, bonus %, tier factors, level thresholds — and both <code>Enabled</code>
            flags are appsettings/code only, on purpose. Multipliers boost <b>comp</b>, never winnings.
        </p>
        <form asp-controller="Settings" asp-action="SaveVipLoyalty" method="post">
            <div class="setting-list">
                @foreach (var s in Model.VipLoyalty)
                {
                    <div class="setting-edit-row2">
                        <div class="setting-meta">
                            <div class="setting-label">@s.Label <span class="dim" style="font-weight:400; font-size:11px">@s.Key</span></div>
                            <div class="setting-help">@s.Help</div>
                        </div>
                        <input class="input setting-input" type="number" step="@s.Step" min="@s.Min" name="@s.Key" value="@s.Value" placeholder="default" />
                    </div>
                }
            </div>
            <div style="margin-top:18px"><button class="btn btn-primary" type="submit">Save VIP &amp; Loyalty</button></div>
        </form>
    </div>

    @* ------------------------------------------------ VIP tier ladder ------------------------------------------------ *@
    <div class="panel" style="margin-top:16px">
        <div class="panel-head">
            <h3>VIP tier ladder</h3>
            <span class="badge badge-live">Live · next accrual</span>
        </div>
        <p class="page-sub">
            The RANK ladder. A tier is reached with <strong>both</strong> its SP bar (trailing window) and its USD spend floor —
            a floor above $0 means that tier cannot be reached without paying. <strong>Comp %</strong> is the tier's slice of the
            benefit multiplier; <strong>grind ×</strong> is how fast the same SP builds VIP&nbsp;Levels. Tier <em>None</em> must stay at
            <strong>×0</strong>, or players below the VIP entry level start grinding VIP Levels.
        </p>
        <form asp-controller="Settings" asp-action="SaveVipTiers" method="post">
            <table class="data-table" id="vipTierTable">
                <thead>
                    <tr>
                        <th style="text-align:left">Tier</th>
                        <th style="text-align:left">SP required</th>
                        <th style="text-align:left">Spend floor (USD)</th>
                        <th style="text-align:left">Comp %</th>
                        <th style="text-align:left">Grind ×</th>
                    </tr>
                </thead>
                <tbody>
                    @{ var tierNames = new[] { "None", "Bronze", "Silver", "Gold", "Platinum", "Diamond", "Royal Diamond", "Black Diamond" }; }
                    @for (int i = 0; i < Model.VipTiers.Count && i < tierNames.Length; i++)
                    {
                        var t = Model.VipTiers[i];
                        <tr>
                            <td><strong>@tierNames[i]</strong></td>
                            <td><input class="input" type="number" min="0" step="1000" name="tierSp" value="@t.SpThreshold" style="width:170px" /></td>
                            <td><input class="input" type="number" min="0" step="1" name="tierFloor" value="@t.SpendFloorUsd" style="width:140px" /></td>
                            <td><input class="input" type="number" min="0" step="1" name="tierBonus" value="@(t.BonusPct * 100m)" style="width:110px" /></td>
                            <td><input class="input" type="number" min="0" step="0.1" name="tierFactor" value="@t.Factor" style="width:110px" /></td>
                        </tr>
                    }
                </tbody>
            </table>
            <div style="margin-top:14px"><button class="btn btn-primary" type="submit">Save tier ladder</button></div>
        </form>
    </div>

    @* ------------------------------------------------ VIP level ladder ------------------------------------------------ *@
    <div class="panel" style="margin-top:16px">
        <div class="panel-head">
            <h3>VIP level ladder</h3>
            <span class="badge badge-live">Live · next accrual</span>
        </div>
        <p class="page-sub">
            The PREMIUM ladder. <strong>Progress needed</strong> is what it costs to reach that level from the one below, and it is
            CONSUMED on level-up (the remainder carries forward). Progress = <code>SP × the tier's grind ×</code>, and SP from play is
            capped daily — so the days column is the fastest anyone can do it at that tier, not an average.
        </p>
        <form asp-controller="Settings" asp-action="SaveVipLevels" method="post">
            <table class="data-table" id="vipLevelTable">
                <thead>
                    <tr>
                        <th style="text-align:left">Level</th>
                        <th style="text-align:left">Progress needed</th>
                        <th style="text-align:left">Comp %</th>
                        <th style="text-align:left">Maintain (LP / period)</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @for (int i = 0; i < Model.VipLevels.Count; i++)
                    {
                        var l = Model.VipLevels[i];
                        <tr>
                            <td><strong>VIP @(i + 1)</strong></td>
                            <td><input class="input" type="number" min="0" step="100000" name="lvlThreshold" value="@l.Threshold" style="width:190px" /></td>
                            <td><input class="input" type="number" min="0" step="1" name="lvlBonus" value="@(l.BonusPct * 100m)" style="width:110px" /></td>
                            <td><input class="input" type="number" min="0" step="100" name="lvlMaintain" value="@l.MaintainLp" style="width:170px" /></td>
                            <td><button type="button" class="btn" onclick="this.closest('tr').remove()">Remove</button></td>
                        </tr>
                    }
                </tbody>
            </table>
            <div style="margin-top:14px; display:flex; gap:10px; flex-wrap:wrap">
                <button type="button" class="btn" id="addVipLevel">+ Add level</button>
                <button class="btn btn-primary" type="submit">Save level ladder</button>
            </div>
        </form>
        <p class="page-sub" style="margin-top:14px">
            A row with <strong>no progress</strong> is dropped, which is how you delete a level; an empty table is refused.
            Players already above a removed top level keep it until it lapses. To go back to the built-in ladder, delete
            <code>Vip:Levels</code> from Redis.
        </p>
    </div>

    @* ------------------------------------------------ LP store ------------------------------------------------ *@
    <div class="panel" style="margin-top:16px">
        <div class="panel-head">
            <h3>LP store</h3>
            <span class="badge badge-live">Live · ~15 s</span>
        </div>
        <p class="page-sub">
            What Loyalty Points buy. <strong>This table decides what an LP is worth</strong>: a player earns 1 LP per
            <code>@Model.LpChipsPerPoint.ToString("#,0.##")</code> chips wagered (Loyalty:LpChipsPerPoint above), so an item costing
            <em>C</em> LP for <em>A</em> chips returns <code>A / (C × @Model.LpChipsPerPoint.ToString("#,0.##"))</code> of everything wagered
            to earn it. The <strong>comp %</strong> column does that arithmetic live — anything near or above 100% is not a comp, it is a
            loop that pays more than it costs to play.
        </p>
        <form asp-controller="Settings" asp-action="SaveLoyaltyCatalog" method="post">
            <table class="data-table" id="lpTable" data-lp-rate="@Model.LpChipsPerPoint.ToString(System.Globalization.CultureInfo.InvariantCulture)">
                <thead>
                    <tr>
                        <th style="text-align:left">Id</th>
                        <th style="text-align:left">Name</th>
                        <th style="text-align:left">Cost (LP)</th>
                        <th style="text-align:left">Chips</th>
                        <th style="text-align:left">Min tier</th>
                        <th style="text-align:left">Comp %</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.LoyaltyCatalog)
                    {
                        var comp = item.CostLp > 0 && Model.LpChipsPerPoint > 0m
                            ? item.ChipAmount / (item.CostLp * Model.LpChipsPerPoint) * 100m : 0m;
                        <tr>
                            <td><input class="input" type="text" name="lpId" value="@item.Id" style="width:130px" /></td>
                            <td><input class="input" type="text" name="lpName" value="@item.Name" style="width:180px" /></td>
                            <td><input class="input" type="number" min="0" step="10" name="lpCost" value="@item.CostLp" style="width:120px" /></td>
                            <td><input class="input" type="number" min="0" step="1000" name="lpAmount" value="@item.ChipAmount" style="width:160px" /></td>
                            <td><input class="input" type="number" min="0" max="7" step="1" name="lpMinTier" value="@item.MinVipTier" style="width:100px" /></td>
                            <td class="lp-comp" style="color:@(comp >= 50m ? "var(--bad,#f87171)" : comp >= 10m ? "var(--warn,#fbbf24)" : "var(--muted,#9aa4b2)")">
                                @comp.ToString("#,0.##")%
                            </td>
                            <td><button type="button" class="btn" onclick="this.closest('tr').remove()">Remove</button></td>
                        </tr>
                    }
                </tbody>
            </table>
            <div style="margin-top:14px; display:flex; gap:10px; flex-wrap:wrap">
                <button type="button" class="btn" id="addLpItem">+ Add item</button>
                <button class="btn btn-primary" type="submit">Save LP store</button>
            </div>
        </form>
        <p class="page-sub" style="margin-top:14px">
            A row with <strong>no id, cost or chips</strong> is dropped, which is how you delete one; an empty table is refused, and so
            are duplicate ids. Min tier is <code>0</code> None … <code>7</code> Black Diamond. To go back to the built-in list, delete
            <code>Loyalty:Catalog</code> from Redis.
        </p>
    </div>
</div>

<div class="tab-panel hidden" data-panel="store">
    <div class="panel">
        <div class="panel-head">
            <h3>In-app store</h3>
            <span class="badge badge-live">Live · read per request</span>
        </div>
        <p class="page-sub" style="margin-top:0">
            The kill switches and policy of the real-money store (<code>docs/IAP_SPEC.md</code> §7.1). The game reads these from the
            overlay on every request — no restart. Credentials (Play service account, Apple certificate / API key) live in the game
            server's <code>appsettings.json</code>; the <a asp-controller="Store" asp-action="Index">Store page</a> shows whether each
            platform's verifier actually loaded. The catalog itself is edited there too.
        </p>
        <form asp-controller="Settings" asp-action="SaveStore" method="post">
            <div class="setting-list">
                @foreach (var f in Model.StoreFlags)
                {
                    <div class="setting-edit-row2">
                        <div class="setting-meta">
                            <div class="setting-label">@f.Label</div>
                            <div class="setting-help">@f.Help</div>
                        </div>
                        <input class="setting-input" type="checkbox" name="@f.Key" value="on" @(f.On ? "checked" : "") />
                    </div>
                }
                <div class="setting-edit-row2">
                    <div class="setting-meta">
                        <div class="setting-label">Refund policy</div>
                        <div class="setting-help"><strong>Rollback</strong> reverses the credited lines through the wallet's own reversal when the chips are still there (never negative; flags when already spent). <strong>Flag</strong> only records the refund. Piggy/VIP effects are never unwound either way.</div>
                    </div>
                    <select class="input setting-input" name="Store:Refunds:Policy">
                        <option value="Rollback" selected="@(Model.StoreRefundPolicy == "Rollback")">Rollback</option>
                        <option value="Flag" selected="@(Model.StoreRefundPolicy == "Flag")">Flag</option>
                    </select>
                </div>
                <div class="setting-edit-row2">
                    <div class="setting-meta">
                        <div class="setting-label">XP per USD</div>
                        <div class="setting-help">XP granted per reference-USD of a verified purchase (bypasses the daily cap). 0 = off — purchased chips earn XP when wagered.</div>
                    </div>
                    <input class="input setting-input" type="number" step="1" min="0" name="Store:XpPerUsd" value="@Model.StoreXpPerUsd" />
                </div>
            </div>
            <div style="margin-top:18px"><button class="btn btn-primary" type="submit">Save store settings</button></div>
        </form>
    </div>
</div>

<div class="tab-panel hidden" data-panel="transfer">
    <div class="panel">
        <div class="panel-head">
            <h3>Export tuning to another server</h3>
            <span class="badge badge-plan">file · applied on next start</span>
        </div>

        <p class="page-sub" style="margin-top:0">
            Tuning lives in Redis, so none of it travels with a build. Export what you want, drop the file at
            <code>config/khela-settings.json</code> beside the published API, and the server writes it into its own
            Redis the next time it starts.
        </p>
        <p class="page-sub">
            It applies <strong>once per file</strong>, not once per boot — the content is hashed and remembered, so a
            later restart never undoes tuning done live on that server since. It <strong>merges</strong>: only the keys
            in the file are written, nothing is deleted.
        </p>

        <form asp-controller="Settings" asp-action="Export" method="post">
            <div class="setting-list">
                <div class="setting-edit-row2">
                    <div class="setting-meta">
                        <div class="setting-label">Piggy bank</div>
                        <div class="setting-help">Rates, daily cap, window, thresholds — every <code>Piggy:</code> knob.</div>
                    </div>
                    <input class="setting-input" type="checkbox" name="groups" value="piggy" checked />
                </div>

                <div class="setting-edit-row2">
                    <div class="setting-meta">
                        <div class="setting-label">Monthly pass ladder</div>
                        <div class="setting-help">The whole authored program — days, rewards, artwork, texts (<code>khela:pass</code>).</div>
                    </div>
                    <input class="setting-input" type="checkbox" name="groups" value="pass" checked />
                </div>

                <div class="setting-edit-row2">
                    <div class="setting-meta">
                        <div class="setting-label">Daily login ladder</div>
                        <div class="setting-help">The 28-day ladder and its rewards (<code>khela:daily</code>).</div>
                    </div>
                    <input class="setting-input" type="checkbox" name="groups" value="daily" checked />
                </div>

                <div class="setting-edit-row2">
                    <div class="setting-meta">
                        <div class="setting-label">Missions</div>
                        <div class="setting-help">The mission catalog (<code>khela:missions</code>).</div>
                    </div>
                    <input class="setting-input" type="checkbox" name="groups" value="missions" checked />
                </div>

                <div class="setting-edit-row2">
                    <div class="setting-meta">
                        <div class="setting-label">Chests</div>
                        <div class="setting-help">The chest catalog (<code>khela:chests</code>).</div>
                    </div>
                    <input class="setting-input" type="checkbox" name="groups" value="chests" checked />
                </div>
                <div class="setting-edit-row2">
                    <div class="setting-meta">
                        <div class="setting-label">Store catalog + switches</div>
                        <div class="setting-help">The real-money catalog (<code>khela:store</code>) and every <code>Store:</code> switch. Credentials never travel — they live in each server's appsettings.</div>
                    </div>
                    <input class="setting-input" type="checkbox" name="groups" value="store" checked />
                </div>

                <div class="setting-edit-row2">
                    <div class="setting-meta">
                        <div class="setting-label">Progression, VIP &amp; loyalty</div>
                        <div class="setting-help">XP curve, level rewards, comp rates.</div>
                    </div>
                    <input class="setting-input" type="checkbox" name="groups" value="progression" />
                </div>

                <div class="setting-edit-row2">
                    <div class="setting-meta">
                        <div class="setting-label">Reward switches</div>
                        <div class="setting-help">
                            <code>Rewards:</code> keys, including <strong>BypassAdForMissedDays</strong>. Off by default:
                            a testing switch should never travel by accident.
                        </div>
                    </div>
                    <input class="setting-input" type="checkbox" name="groups" value="rewards" />
                </div>

                <div class="setting-edit-row2">
                    <div class="setting-meta">
                        <div class="setting-label">Game &amp; table timing</div>
                        <div class="setting-help">
                            Blackjack and table knobs. Off by default — timers are usually environment-specific, and a
                            dev server's shortened windows are exactly what you don't want carried.
                        </div>
                    </div>
                    <input class="setting-input" type="checkbox" name="groups" value="game" />
                </div>

                <div class="setting-edit-row2">
                    <div class="setting-meta">
                        <div class="setting-label">Note</div>
                        <div class="setting-help">Logged by the receiving server when it applies the file. "piggy pacing, 19 Aug".</div>
                    </div>
                    <input class="input setting-input" type="text" name="note" placeholder="what this carries" />
                </div>
            </div>

            <div style="margin-top:18px; display:flex; gap:10px; flex-wrap:wrap">
                <button class="btn btn-primary" type="submit" name="mode" value="download">Download settings file</button>
                <button class="btn" type="submit" name="mode" value="save">Save to disk</button>
            </div>
        </form>

        <p class="page-sub" style="margin-top:18px">
            Only knobs that have been <strong>saved here</strong> are in Redis — anything still on its appsettings
            default is not exported, because the target already has that default.
        </p>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            // Add a tier row by cloning the last one and blanking it — cloning keeps the inputs identical to the
            // server's expectations (same names, same types) without duplicating the markup in JS.
            var add = document.getElementById('addTier');
            if (add) {
                add.addEventListener('click', function () {
                    var body = document.querySelector('#tierTable tbody');
                    if (!body) return;

                    var row;
                    if (body.rows.length > 0) {
                        row = body.rows[body.rows.length - 1].cloneNode(true);
                        row.querySelectorAll('input').forEach(function (i) { i.value = ''; });
                    } else {
                        row = document.createElement('tr');
                        row.innerHTML =
                            '<td><input class="input" type="number" min="1" step="1" name="tierMinLevel" style="width:120px" /></td>' +
                            '<td><input class="input" type="number" min="0" step="1000" name="tierMaxAmount" style="width:200px" /></td>' +
                            '<td><input class="input" type="text" name="tierSku" style="width:220px" /></td>' +
                            '<td><button type="button" class="btn">Remove</button></td>';
                    }

                    var remove = row.querySelector('button');
                    if (remove) remove.onclick = function () { row.remove(); };

                    body.appendChild(row);
                });
            }
        })();

        // The VIP-level and LP-store tables add rows the same way: clone the last row and blank it, so a new row always
        // carries exactly the inputs the server expects. The label cell is renumbered for VIP levels (the server reads
        // position, not the label, but a table that says "VIP 3" twice is a table nobody trusts).
        (function () {
            // VIP levels are saved by POSITION, so the "VIP n" labels must be rebuilt after EVERY mutation — add or remove.
            // A table that still says "VIP 10 = 28,000,000" after row 5 was removed is showing a ladder the server will not run.
            function renumberVipLevels() {
                var body = document.querySelector('#vipLevelTable tbody');
                if (!body) return;
                for (var r = 0; r < body.rows.length; r++) {
                    var cell = body.rows[r].cells[0];
                    if (cell) cell.innerHTML = '<strong>VIP ' + (r + 1) + '</strong>';
                }
            }

            // The LP comp % is the peg guard rail, so it has to track what is TYPED, not what was rendered.
            function recomputeLp(row) {
                var table = document.getElementById('lpTable');
                if (!table || !row) return;
                var rate = parseFloat(table.getAttribute('data-lp-rate')) || 0;
                var cost = parseFloat((row.querySelector('input[name="lpCost"]') || {}).value) || 0;
                var chips = parseFloat((row.querySelector('input[name="lpAmount"]') || {}).value) || 0;
                var cell = row.querySelector('.lp-comp');
                if (!cell) return;
                if (rate <= 0 || cost <= 0 || chips <= 0) { cell.textContent = '—'; cell.style.color = 'var(--muted,#9aa4b2)'; return; }
                var pct = chips / (cost * rate) * 100;
                cell.textContent = (Math.round(pct * 100) / 100).toLocaleString() + '%';
                cell.style.color = pct >= 50 ? 'var(--bad,#f87171)' : pct >= 10 ? 'var(--warn,#fbbf24)' : 'var(--muted,#9aa4b2)';
            }

            // One delegated handler per table: remove works for server-rendered AND cloned rows without rebinding.
            function wire(tableId, afterMutate) {
                var table = document.getElementById(tableId);
                if (!table) return;
                table.addEventListener('click', function (e) {
                    var btn = e.target.closest('button');
                    if (!btn || btn.type === 'submit') return;
                    var row = btn.closest('tr');
                    if (row) { row.remove(); if (afterMutate) afterMutate(); }
                });
            }
            wire('vipLevelTable', renumberVipLevels);
            wire('lpTable', null);

            var lpTable = document.getElementById('lpTable');
            if (lpTable) lpTable.addEventListener('input', function (e) {
                var n = e.target.getAttribute('name');
                if (n === 'lpCost' || n === 'lpAmount') recomputeLp(e.target.closest('tr'));
            });

            function adder(buttonId, tableId, afterMutate) {
                var add = document.getElementById(buttonId);
                if (!add) return;
                add.addEventListener('click', function () {
                    var body = document.querySelector('#' + tableId + ' tbody');
                    if (!body || body.rows.length === 0) return;
                    var row = body.rows[body.rows.length - 1].cloneNode(true);
                    row.querySelectorAll('input').forEach(function (i) { i.value = ''; });
                    var comp = row.querySelector('.lp-comp');   // a cloned row must not inherit the last row's percentage
                    if (comp) { comp.textContent = '—'; comp.style.color = 'var(--muted,#9aa4b2)'; }
                    body.appendChild(row);
                    if (afterMutate) afterMutate();
                });
            }
            adder('addVipLevel', 'vipLevelTable', renumberVipLevels);
            adder('addLpItem', 'lpTable', null);
        })();

        (function () {
            var tabs = document.querySelectorAll('.tab');
            var panels = document.querySelectorAll('.tab-panel');
            tabs.forEach(function (t) {
                t.addEventListener('click', function () {
                    tabs.forEach(function (x) { x.classList.remove('active'); });
                    t.classList.add('active');
                    var key = t.getAttribute('data-tab');
                    panels.forEach(function (p) { p.classList.toggle('hidden', p.getAttribute('data-panel') !== key); });
                });
            });
        })();
    </script>
}
