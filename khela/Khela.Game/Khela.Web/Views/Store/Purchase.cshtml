@using System.Globalization
@using Khela.Common.Store
@using Khela.Game.Database.Models
@using Khela.Web.Controllers
@model StorePurchaseVm
@{
    var r = Model.Row;
    ViewData["Title"] = "Purchase " + r.ProductId;
    ViewData["Crumb"] = "Store · Purchase";
    ViewData["Nav"] = "store";
    string Usd(decimal d) => "$" + d.ToString("0.00", CultureInfo.InvariantCulture);
    string When(DateTime? d) => d.HasValue ? d.Value.ToString("yyyy-MM-dd HH:mm:ss") : "—";
    string StatusClass(StorePurchaseStatus s) => s switch
    {
        StorePurchaseStatus.Granted => "active",
        StorePurchaseStatus.Invalid => "suspend",
        StorePurchaseStatus.Refunded => "suspend",
        StorePurchaseStatus.Revoked => "suspend",
        StorePurchaseStatus.Expired => "suspend",
        _ => "pending"
    };
    bool canRedrive = r.Status == StorePurchaseStatus.Pending || r.Status == StorePurchaseStatus.Verified || r.Status == StorePurchaseStatus.Invalid || (r.Status == StorePurchaseStatus.Granted && r.CompletedAt == null);
    bool canRefund = r.Status == StorePurchaseStatus.Granted;
}

<h1 class="page-title">Purchase <span class="dim" style="font-size:16px">@r.Id</span></h1>
<p class="page-sub"><a asp-action="Purchases">← All purchases</a> · <a asp-action="Purchases" asp-route-q="@r.UserId">this player's purchases</a> · <a asp-controller="Wallets" asp-action="Index" asp-route-q="@r.UserId">wallet ledger</a></p>

@if (!string.IsNullOrEmpty(Model.Saved))
{
    <div class="panel" style="border-left:3px solid var(--ok,#34d399); margin-bottom:14px"><div style="padding:12px 16px; color:var(--ok,#34d399)">@Model.Saved</div></div>
}
@if (!string.IsNullOrEmpty(Model.Error))
{
    <div class="panel" style="border-left:3px solid var(--bad,#f87171); margin-bottom:14px"><div style="padding:12px 16px; color:var(--bad,#f87171)">@Model.Error</div></div>
}

<div class="panel">
    <div class="panel-head">
        <h3>@r.ProductId <span class="pill @StatusClass(r.Status)">@r.Status</span> @if (r.IsTest) { <span class="pill pending">TEST</span> }</h3>
        <span class="dim" style="font-size:12.5px">@r.Platform · @r.ProductType · @(r.Environment ?? "")</span>
    </div>
    <div class="kv">
        <div><span>Player</span><b>@(Model.PlayerName ?? "—")</b> <span class="dim">@Model.Email · @r.UserId</span></div>
        <div><span>Store product</span><b>@r.StoreProductId</b></div>
        <div><span>Order id</span><b>@(r.StoreOrderId ?? "—")</b></div>
        <div><span>Transaction key</span><span class="dim" style="word-break:break-all">@r.StoreTransactionId</span></div>
        <div><span>Original transaction</span><span class="dim" style="word-break:break-all">@(r.OriginalTransactionId ?? "—")</span></div>
        <div><span>Reference USD</span><b>@Usd(r.UsdReference)</b> <span class="dim">store price @(r.ClientPriceMicros.HasValue ? (r.ClientPriceMicros.Value / 1_000_000m).ToString("0.00", CultureInfo.InvariantCulture) + " " + r.ClientPriceCurrency : "—") · region @(r.RegionCode ?? "—") · country @(r.CountryCode ?? "—")</span></div>
        <div><span>Account binding</span><span class="dim">@(r.ObfuscatedAccountId ?? "— (not reported)")</span></div>
        <div><span>Created</span>@When(r.CreatedAt) <span class="dim">· verified @When(r.VerifiedAt) · granted @When(r.GrantedAt) · completed @When(r.CompletedAt)</span></div>
        <div><span>Acknowledged</span>@When(r.AcknowledgedAt) <span class="dim">(Google: consumed/acknowledged server-side; the 3-day auto-refund backstop)</span></div>
        @if (r.SubscriptionExpiresAt.HasValue) { <div><span>Subscription expires</span>@When(r.SubscriptionExpiresAt)</div> }
        @if (r.RefundedAt.HasValue) { <div><span>Refunded</span>@When(r.RefundedAt) <span class="dim">source @r.RefundSource</span></div> }
        <div><span>Attempts</span>@r.Attempts <span class="dim">@(string.IsNullOrEmpty(r.LastError) ? "" : "· last error: " + r.LastError)</span></div>
        <div><span>Client</span><span class="dim">@(r.ClientVersion ?? "—") · intent @(r.ClientPurchaseId ?? "—")</span></div>
    </div>
    <div style="display:flex; gap:10px; padding:0 16px 16px; flex-wrap:wrap; align-items:center">
        @if (canRedrive)
        {
            <form asp-action="Redrive" method="post" style="display:inline" onsubmit="return confirm('Queue a re-drive? The game re-verifies with the store and completes whatever is still owed. Every leg is idempotent.');">
                <input type="hidden" name="id" value="@r.Id" />
                <button class="btn btn-primary" type="submit">Re-drive</button>
            </form>
        }
        @if (canRefund)
        {
            <form asp-action="Refund" method="post" style="display:inline; display:flex; gap:8px; align-items:center" onsubmit="return confirm('Mark refunded? The game applies Store:Refunds:Policy — Rollback reverses the credited lines if unspent (never negative), else flags. Piggy/VIP effects are never unwound.');">
                <input type="hidden" name="id" value="@r.Id" />
                <input name="reason" placeholder="reason (support ticket, chargeback…)" class="vip-select" style="width:260px" />
                <button class="btn btn-outline" type="submit">Mark refunded</button>
            </form>
        }
        <span class="dim" style="font-size:12px">Both actions are queued for the game server (≤ 2 min). This page never moves money.</span>
    </div>
</div>

<div class="panel">
    <div class="panel-head"><h3>Fulfilment</h3><span class="dim" style="font-size:12.5px">what the ledger actually did — lines with their correlation ids, effects, flags</span></div>
    <pre class="json-view">@(Model.Fulfilment ?? "— nothing granted yet")</pre>
</div>

<div class="panel">
    <div class="panel-head"><h3>Verifier evidence</h3><span class="dim" style="font-size:12.5px">the store's answer (API response / decoded JWS)</span></div>
    <pre class="json-view">@(Model.Verifier ?? "— not verified yet")</pre>
</div>

<div class="panel">
    <div class="panel-head"><h3>Catalog snapshot</h3><span class="dim" style="font-size:12.5px">the product as it was when reserved — what this purchase pays, regardless of later edits</span></div>
    <pre class="json-view">@(Model.Snapshot ?? "—")</pre>
</div>

<div class="panel">
    <div class="panel-head"><h3>Raw receipt</h3><span class="dim" style="font-size:12.5px">capped at Store:MaxReceiptBytes · evidence for disputes</span></div>
    <details><summary class="dim" style="cursor:pointer; padding:10px 16px">show</summary><pre class="json-view">@(r.RawReceipt ?? "—")</pre></details>
</div>

<div class="panel">
    <div class="panel-head"><h3>Events</h3><span class="dim" style="font-size:12.5px">webhooks / polls that touched this purchase</span></div>
    <table class="data-table">
        <thead><tr><th>Received (UTC)</th><th>Type</th><th>Event id</th><th>Processed</th><th>Error</th></tr></thead>
        <tbody>
            @foreach (var e in Model.Events)
            {
                <tr>
                    <td class="dim" style="font-size:12px">@When(e.ReceivedAt)</td>
                    <td>@e.EventType</td>
                    <td class="dim" style="font-size:11.5px">@e.EventId</td>
                    <td class="dim" style="font-size:12px">@When(e.ProcessedAt)</td>
                    <td class="dim" style="font-size:12px">@e.Error</td>
                </tr>
            }
            @if (Model.Events.Count == 0)
            {
                <tr><td colspan="5" class="dim" style="padding:18px 16px">No events.</td></tr>
            }
        </tbody>
    </table>
</div>

<style>
    .kv { display:grid; grid-template-columns:1fr; gap:6px; padding:14px 16px; font-size:13px; }
    .kv > div > span:first-child { display:inline-block; width:170px; color:var(--muted,#9aa4b2); }
    .json-view { margin:0; padding:12px 16px; white-space:pre-wrap; word-break:break-all; font-family:ui-monospace,Consolas,"Courier New",monospace; font-size:12px; line-height:1.45; color:var(--text,#e6e9ef); max-height:420px; overflow:auto; }
    .vip-select { background:var(--panel-2,#1a2030); color:var(--text,#e6e9ef); border:1px solid var(--border,#2a3344); border-radius:6px; padding:6px 8px; font-size:13px; }
</style>
