@using System.Linq
@using Khela.Game.Services.Pass
@using Khela.Web.Controllers
@model PassEditVm
@{
    ViewData["Title"] = "Pass · " + Model.Program.Key;
    ViewData["Crumb"] = "Pass";
    ViewData["Nav"] = "pass";
    var p = Model.Program;
    string Totals(Dictionary<string, decimal> t) => t.Count == 0 ? "—" : string.Join(" · ", t.OrderBy(k => k.Key).Select(k => $"{k.Value:#,0} {k.Key}"));
}

<h1 class="page-title">@p.Title <span class="dim" style="font-size:14px">(@p.Key)</span></h1>
<p class="page-sub">
    Day <b>N</b> of the cycle is node <b>N</b> — the ladder tracks the calendar, so nobody can run ahead of it.
    @if (Model.Cycle != null)
    {
        <text>Live cycle <b>@Model.Cycle.CycleKey</b> (@Model.Cycle.Length days in UTC; a player's own month decides theirs).</text>
    }
    <a asp-action="Index">← all programs</a>
</p>

@if (!string.IsNullOrEmpty(Model.Saved))
{
    <div class="panel" style="border-left:3px solid var(--ok,#34d399); margin-bottom:14px"><div style="padding:12px 16px; color:var(--ok,#34d399)">@Model.Saved</div></div>
}
@if (!string.IsNullOrEmpty(Model.Error))
{
    <div class="panel" style="border-left:3px solid var(--bad,#f87171); margin-bottom:14px"><div style="padding:12px 16px; color:var(--bad,#f87171)">@Model.Error</div></div>
}

<div class="panel">
    <div class="panel-head">
        <h3>Season totals</h3>
        <span class="dim" style="font-size:12.5px">what a player who claims every day walks away with</span>
    </div>
    <table class="data-table">
        <tbody>
            <tr><td style="width:120px"><b>Free</b></td><td>@Totals(Model.FreeTotals)</td></tr>
            <tr><td><b>Golden</b></td><td>@Totals(Model.GoldenTotals)</td></tr>
        </tbody>
    </table>
</div>

<form asp-action="Save" method="post">
    <input type="hidden" name="Key" value="@p.Key" />

    <div class="panel">
        <div class="panel-head"><h3>Settings</h3></div>
        <div style="padding:14px 16px; display:grid; grid-template-columns:repeat(auto-fit,minmax(260px,1fr)); gap:14px">
            <label>Title<br /><input name="Title" value="@p.Title" class="vip-select" style="width:100%" /></label>
            <label>Cadence<br />
                <select name="Cadence" class="vip-select" style="width:100%">
                    <option value="Monthly" selected="@(p.Cadence == PassCadence.Monthly)">Monthly (renews on the 1st)</option>
                    <option value="Fixed" selected="@(p.Cadence == PassCadence.Fixed)">Fixed window (season pass)</option>
                </select>
            </label>
            <label>Catch-up policy<br />
                <select name="CatchUp" class="vip-select" style="width:100%">
                    @foreach (var v in Enum.GetValues<CatchUpPolicy>())
                    {
                        <option value="@v" selected="@(p.CatchUp == v)">@v</option>
                    }
                </select>
            </label>
            <label>Ads per missed day<br /><input name="AdsPerCatchUp" type="number" min="0" max="10" value="@p.AdsPerCatchUp" class="vip-select" style="width:100%" /></label>
            <label>Max ad catch-ups / cycle<br /><input name="MaxAdCatchUpsPerCycle" type="number" min="0" max="31" value="@p.MaxAdCatchUpsPerCycle" class="vip-select" style="width:100%" /></label>
            <label>Apple product id<br /><input name="GoldenProductIdApple" value="@p.GoldenProductIdApple" class="vip-select" style="width:100%" /></label>
            <label>Google product id<br /><input name="GoldenProductIdGoogle" value="@p.GoldenProductIdGoogle" class="vip-select" style="width:100%" /></label>
            <label>Display price (USD)<br /><input name="GoldenPriceUsd" type="number" step="0.01" min="0" value="@p.GoldenPriceUsd" class="vip-select" style="width:100%" /></label>
            @if (p.Cadence == PassCadence.Fixed)
            {
                <label>Starts (UTC)<br /><input name="StartUtc" type="datetime-local" value="@(p.StartUtc?.ToString("yyyy-MM-ddTHH:mm"))" class="vip-select" style="width:100%" /></label>
                <label>Ends (UTC)<br /><input name="EndUtc" type="datetime-local" value="@(p.EndUtc?.ToString("yyyy-MM-ddTHH:mm"))" class="vip-select" style="width:100%" /></label>
            }
            <label style="align-self:end"><input name="Enabled" type="checkbox" value="true" checked="@p.Enabled" /> Live</label>
        </div>
        <div class="dim" style="font-size:11.5px; padding:0 16px 14px">
            <b>GoldenOrAds</b> (default): today is free for everyone; a missed day is free for subscribers and costs
            ad views for everyone else, up to the per-cycle cap. The subscription price itself comes from the store —
            the USD figure here is only a fallback label.
        </div>
    </div>

    <div class="panel">
        <div class="panel-head">
            <h3>Ladder</h3>
            <span class="dim" style="font-size:12.5px">
                @p.Nodes.Count days · click a day to edit it
            </span>
        </div>

        @* The inputs the controller binds are HIDDEN inside each card and stay in day order — Save() reads
           Free[]/FreeText[]/Golden[]/GoldenText[] positionally, so the DOM order IS the day order. The modal only
           writes into them; nothing about the post shape changed. *@
        <div class="day-grid">
            @for (int i = 0; i < p.Nodes.Count; i++)
            {
                var node = p.Nodes[i];
                var beyondFeb = node.Index > PassCatalog.GuaranteedDays;
                var freeLine = PassRewardText.Format(node.Free);
                var goldenLine = PassRewardText.Format(node.Golden);
                var freeAuto = PassCatalog.AutoLabel(node.Free);
                var goldenAuto = PassCatalog.AutoLabel(node.Golden);

                <div class="day-card@(node.IsMilestone ? " is-milestone" : "")" data-i="@i" data-day="@node.Index"
                     data-free-auto="@freeAuto" data-golden-auto="@goldenAuto" tabindex="0" role="button"
                     title="Edit day @node.Index">

                    <input type="hidden" name="Free" value="@freeLine" />
                    <input type="hidden" name="FreeText" value="@node.FreeText" />
                    <input type="hidden" name="Golden" value="@goldenLine" />
                    <input type="hidden" name="GoldenText" value="@node.GoldenText" />
                    <input type="checkbox" name="Milestone" value="@node.Index" checked="@node.IsMilestone" hidden />

                    <div class="day-head">
                        <span class="day-no">@node.Index</span>
                        <span class="day-flags">
                            <span class="star" title="Milestone">★</span>
                            @if (beyondFeb)
                            {
                                <span class="dim" title="This day doesn't exist in every month">✱</span>
                            }
                        </span>
                    </div>

                    <div class="track track-free">
                        <span class="track-tag">FREE</span>
                        <b class="v-text" data-auto="@freeAuto">@(string.IsNullOrWhiteSpace(node.FreeText) ? freeAuto : node.FreeText)</b>
                        <span class="v-line">@freeLine</span>
                    </div>

                    <div class="track track-golden">
                        <span class="track-tag">GOLDEN</span>
                        <b class="v-text" data-auto="@goldenAuto">@(string.IsNullOrWhiteSpace(node.GoldenText) ? goldenAuto : node.GoldenText)</b>
                        <span class="v-line">@(string.IsNullOrWhiteSpace(goldenLine) ? "—" : goldenLine)</span>
                    </div>
                </div>
            }
        </div>

        <div style="display:flex; gap:10px; padding:14px 16px; align-items:center; flex-wrap:wrap">
            <button type="submit" class="btn btn-primary">Save ladder</button>
            <span class="dim" style="font-size:12px">
                Edits are held in the page until you save. ✱ = only exists in longer months; a <b>★ milestone</b> above
                day @PassCatalog.GuaranteedDays is refused, because February players could never reach it.
            </span>
        </div>
    </div>

    @* ONE modal, reused for every day. It edits the hidden inputs of whichever card was opened. *@
    <div class="modal-back" id="dayModal" hidden>
        <div class="modal" role="dialog" aria-modal="true" aria-labelledby="dayModalTitle">
            <div class="modal-head">
                <h3 id="dayModalTitle">Day</h3>
                <button type="button" class="btn btn-outline modal-x" data-close>✕</button>
            </div>

            <div class="modal-body">
                <section class="rw-sec">
                    <div class="rw-head">
                        <span class="track-tag" style="color:#6fb3f2">FREE</span>
                        <button type="button" class="btn btn-outline btn-sm" data-add="free">+ reward</button>
                    </div>
                    <div class="rw-list" id="rwFree"></div>
                    <label class="fld">
                        <span>Card text <em class="dim">— blank uses the derived label</em></span>
                        <input id="mFreeText" class="vip-select" />
                    </label>
                </section>

                <section class="rw-sec">
                    <div class="rw-head">
                        <span class="track-tag" style="color:#d8a12a">GOLDEN</span>
                        <button type="button" class="btn btn-outline btn-sm" data-add="golden">+ reward</button>
                    </div>
                    <div class="rw-list" id="rwGolden"></div>
                    <label class="fld">
                        <span>Card text <em class="dim">— blank uses the derived label</em></span>
                        <input id="mGoldenText" class="vip-select" />
                    </label>
                </section>

                <label class="fld fld-check">
                    <input type="checkbox" id="mMilestone" /> <span>★ Milestone</span>
                </label>

                <details class="rw-raw">
                    <summary class="dim">Raw text (advanced)</summary>
                    <label class="fld"><span>Free</span><input id="mFree" class="vip-select" readonly /></label>
                    <label class="fld"><span>Golden</span><input id="mGolden" class="vip-select" readonly /></label>
                    <div class="dim modal-help">
                        This is what gets saved, rebuilt from the rows above.
                        Artwork is appended as <code>@@back.png|front.png</code> — back layer first, up to 3.
                    </div>
                </details>
            </div>

            @* Chest ids offered as a datalist, so a chest row is picked rather than remembered. *@
            <datalist id="chestIds">
                @foreach (var id in Model.ChestIds)
                {
                    <option value="@id"></option>
                }
            </datalist>

            <div class="modal-foot">
                <button type="button" class="btn btn-outline" data-close>Cancel</button>
                <button type="button" class="btn btn-primary" id="mApply">Apply</button>
                <span class="dim" style="font-size:12px">Applied to the page — press <b>Save ladder</b> to write it.</span>
            </div>
        </div>
    </div>
</form>

<div class="panel">
    <div class="panel-head"><h3>Bulk tools</h3></div>
    <form asp-action="ApplyRange" method="post" style="display:flex; gap:10px; padding:14px 16px; align-items:center; flex-wrap:wrap">
        <input type="hidden" name="key" value="@p.Key" />
        <b style="font-size:13px">Days</b>
        <input name="from" type="number" min="1" value="1" class="vip-select" style="width:80px" />
        <span class="dim">→</span>
        <input name="to" type="number" min="1" value="@p.Nodes.Count" class="vip-select" style="width:80px" />
        <input name="free" placeholder="Free (blank = leave alone)" class="vip-select" style="flex:1; min-width:220px" />
        <input name="golden" placeholder="Golden (blank = leave alone)" class="vip-select" style="flex:1; min-width:220px" />
        <select name="milestone" class="vip-select">
            <option value="">★ unchanged</option>
            <option value="true">★ on</option>
            <option value="false">★ off</option>
        </select>
        <button class="btn btn-outline" type="submit">Apply</button>
    </form>
    <form asp-action="Resize" method="post" style="display:flex; gap:10px; padding:0 16px 14px; align-items:center; flex-wrap:wrap">
        <input type="hidden" name="key" value="@p.Key" />
        <b style="font-size:13px">Ladder length</b>
        <input name="length" type="number" min="1" max="@(p.Cadence == PassCadence.Monthly ? PassCatalog.MaxMonthlyNodes : PassCatalog.MaxFixedNodes)" value="@p.Nodes.Count" class="vip-select" style="width:90px" />
        <button class="btn btn-outline" type="submit">Resize</button>
        <span class="dim" style="font-size:12px">New days copy the last one. Shrinking drops days off the end.</span>
    </form>
</div>

<style>
    .vip-select {
        background: var(--panel-2, #1a2030); color: var(--text, #e6e9ef);
        border: 1px solid var(--border, #2a3344); border-radius: 6px; padding: 6px 8px; font-size: 13px;
    }
    label { font-size: 12.5px; color: var(--dim, #93a0b5); }

    /* ---- ladder cards ---- */
    .day-grid {
        display: grid; gap: 10px; padding: 14px 16px;
        grid-template-columns: repeat(auto-fill, minmax(210px, 1fr));
    }
    .day-card {
        background: var(--panel-2, #1a2030); border: 1px solid var(--border, #2a3344);
        border-radius: 8px; padding: 10px 11px; cursor: pointer; outline: none;
        display: flex; flex-direction: column; gap: 8px;
    }
    .day-card:hover, .day-card:focus { border-color: var(--accent, #6b8afd); }
    .day-card.is-milestone { border-color: #d8a12a; }

    .day-head { display: flex; align-items: center; justify-content: space-between; }
    .day-no { font-weight: 700; font-size: 15px; color: var(--text, #e6e9ef); }
    .day-flags { font-size: 12px; color: var(--dim, #93a0b5); }
    /* The star is only drawn on milestone days — toggled by the class, so the modal can flip it live. */
    .day-flags .star { color: #d8a12a; display: none; }
    .day-card.is-milestone .day-flags .star { display: inline; }

    .track { display: flex; flex-direction: column; gap: 2px; }
    .track-tag { font-size: 9.5px; letter-spacing: .09em; color: var(--dim, #93a0b5); }
    .track-free .track-tag { color: #6fb3f2; }
    .track-golden .track-tag { color: #d8a12a; }
    .track .v-text { font-size: 13.5px; color: var(--text, #e6e9ef); }
    .track .v-line {
        font-size: 11px; color: var(--dim, #93a0b5);
        overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
    }

    /* ---- modal ---- */
    .modal-back {
        position: fixed; inset: 0; background: rgba(0,0,0,.55);
        display: flex; align-items: center; justify-content: center; z-index: 50; padding: 20px;
    }
    .modal-back[hidden] { display: none; }
    .modal {
        background: var(--panel, #141a27); border: 1px solid var(--border, #2a3344);
        border-radius: 10px; width: 100%; max-width: 560px; max-height: 90vh; overflow: auto;
    }
    .modal-head {
        display: flex; align-items: center; justify-content: space-between;
        padding: 13px 16px; border-bottom: 1px solid var(--border, #2a3344);
    }
    .modal-head h3 { margin: 0; font-size: 15px; }
    .modal-x { padding: 2px 9px; }
    .modal-body { padding: 14px 16px; display: flex; flex-direction: column; gap: 12px; }
    .fld { display: flex; flex-direction: column; gap: 4px; }
    .fld > span { font-size: 12px; }
    .fld em { font-style: normal; font-size: 11px; }
    .fld-check { flex-direction: row; align-items: center; gap: 8px; }
    .modal-help { font-size: 11.5px; line-height: 1.7; }

    /* ---- reward rows ---- */
    .rw-sec {
        border: 1px solid var(--border, #2a3344); border-radius: 8px; padding: 10px 11px;
        display: flex; flex-direction: column; gap: 10px;
    }
    .rw-head { display: flex; align-items: center; justify-content: space-between; }
    .btn-sm { padding: 2px 9px; font-size: 12px; }
    .rw-list { display: flex; flex-direction: column; gap: 9px; }
    .rw {
        border: 1px solid var(--border, #2a3344); border-radius: 6px; padding: 8px;
        display: flex; flex-direction: column; gap: 6px; background: var(--panel-2, #1a2030);
    }
    .rw-main { display: flex; gap: 6px; align-items: center; }
    .rw-main .rw-kind { width: 110px; }
    .rw-main .rw-id { flex: 1; min-width: 0; }
    .rw-main .rw-amount { width: 110px; }
    .rw-imgs { display: grid; grid-template-columns: repeat(3, 1fr); gap: 6px; }
    .rw-imgs input { min-width: 0; font-size: 11.5px; }
    .rw-raw { font-size: 12px; }
    .rw-raw summary { cursor: pointer; }
    .rw-raw .fld { margin-top: 8px; }
    .modal-foot {
        display: flex; gap: 10px; align-items: center; flex-wrap: wrap;
        padding: 13px 16px; border-top: 1px solid var(--border, #2a3344);
    }
</style>

<script>
    (function () {
        var modal = document.getElementById('dayModal');
        if (!modal) return;

        var title = document.getElementById('dayModalTitle');
        var mFree = document.getElementById('mFree');
        var mFreeText = document.getElementById('mFreeText');
        var mGolden = document.getElementById('mGolden');
        var mGoldenText = document.getElementById('mGoldenText');
        var mMilestone = document.getElementById('mMilestone');
        var card = null;   // the card currently being edited

        function fields(c) {
            return {
                free: c.querySelector('input[name="Free"]'),
                freeText: c.querySelector('input[name="FreeText"]'),
                golden: c.querySelector('input[name="Golden"]'),
                goldenText: c.querySelector('input[name="GoldenText"]'),
                milestone: c.querySelector('input[name="Milestone"]')
            };
        }

        // ---- reward rows ----
        //
        // The stored value is PassRewardText's one-line form ("Chips 1000, Kash 3, XP 50 @@a.png|b.png"). These two
        // functions are its mirror in the browser: parse it into rows to edit, rebuild it to save. The server still
        // parses and validates the string, so this only has to round-trip faithfully — it is not the authority.
        var CURRENCIES = ['Chips', 'Coins', 'Gems', 'Kash'];
        var ITEMISH = ['Chest', 'Item', 'Cosmetic'];

        function parseLine(text) {
            var rows = [];
            (text || '').split(',').forEach(function (raw) {
                var token = raw.trim();
                if (!token) return;

                var images = [];
                var at = token.indexOf('@@');
                if (at >= 0) {
                    images = token.substring(at + 1).split('|').map(function (u) { return u.trim(); }).filter(Boolean);
                    token = token.substring(0, at).trim();
                }
                if (!token) return;

                var parts = token.split(/\s+/);
                var head = parts[0];

                if (head.toUpperCase() === 'XP') {
                    rows.push({ kind: 'XP', id: '', amount: parts[1] || '', images: images });
                } else if (ITEMISH.some(function (k) { return k.toLowerCase() === head.toLowerCase(); })) {
                    var count = parts[2] ? parts[2].replace(/^x/i, '') : '1';
                    rows.push({ kind: head, id: parts[1] || '', amount: count, images: images });
                } else {
                    rows.push({ kind: head, id: '', amount: parts[1] || '', images: images });
                }
            });
            return rows;
        }

        function buildLine(list) {
            var out = [];
            list.querySelectorAll('.rw').forEach(function (r) {
                var kind = r.querySelector('.rw-kind').value;
                var id = r.querySelector('.rw-id').value.trim();
                var amount = r.querySelector('.rw-amount').value.trim();
                var imgs = Array.prototype.map.call(r.querySelectorAll('.rw-img'), function (i) { return i.value.trim(); })
                                             .filter(Boolean).slice(0, 3);

                var body;
                if (kind === 'XP') {
                    if (!amount) return;
                    body = 'XP ' + amount;
                } else if (ITEMISH.indexOf(kind) >= 0) {
                    if (!id) return;
                    body = kind + ' ' + id + (amount && amount !== '1' ? ' x' + amount : '');
                } else {
                    if (!amount) return;
                    body = kind + ' ' + amount;
                }
                out.push(imgs.length ? body + ' @@' + imgs.join('|') : body);
            });
            return out.join(', ');
        }

        function addRow(list, row) {
            row = row || { kind: 'Chips', id: '', amount: '', images: [] };
            var el = document.createElement('div');
            el.className = 'rw';

            var opts = CURRENCIES.concat(['XP']).concat(ITEMISH).map(function (k) {
                return '<option value="' + k + '"' + (k === row.kind ? ' selected' : '') + '>' + k + '</option>';
            }).join('');

            el.innerHTML =
                '<div class="rw-main">' +
                '  <select class="vip-select rw-kind">' + opts + '</select>' +
                '  <input class="vip-select rw-id" list="chestIds" placeholder="id (e.g. CK_Chest:Rare)" />' +
                '  <input class="vip-select rw-amount" type="text" placeholder="amount" />' +
                '  <button type="button" class="btn btn-outline btn-sm rw-del" title="Remove">✕</button>' +
                '</div>' +
                '<div class="rw-imgs">' +
                '  <input class="vip-select rw-img" placeholder="image 1 (back layer)" />' +
                '  <input class="vip-select rw-img" placeholder="image 2" />' +
                '  <input class="vip-select rw-img" placeholder="image 3 (front)" />' +
                '</div>';

            el.querySelector('.rw-id').value = row.id || '';
            el.querySelector('.rw-amount').value = row.amount || '';
            var imgInputs = el.querySelectorAll('.rw-img');
            for (var i = 0; i < 3; i++) imgInputs[i].value = (row.images && row.images[i]) || '';

            el.querySelector('.rw-del').addEventListener('click', function () { el.remove(); refreshRaw(); });
            el.querySelector('.rw-kind').addEventListener('change', function () { kindChanged(el); refreshRaw(); });
            el.addEventListener('input', refreshRaw);

            list.appendChild(el);
            kindChanged(el);
            return el;
        }

        // A currency carries no id (the kind IS the id) and XP carries neither id nor count — hiding the fields that
        // don't apply is what stops the form asking for things the format has no place for.
        function kindChanged(el) {
            var kind = el.querySelector('.rw-kind').value;
            var isItem = ITEMISH.indexOf(kind) >= 0;
            el.querySelector('.rw-id').style.display = isItem ? '' : 'none';
            el.querySelector('.rw-amount').placeholder = isItem ? 'count (blank = 1)' : 'amount';
        }

        function fill(list, text) {
            list.innerHTML = '';
            parseLine(text).forEach(function (r) { addRow(list, r); });
        }

        function refreshRaw() {
            mFree.value = buildLine(rwFree);
            mGolden.value = buildLine(rwGolden);
        }

        var rwFree = document.getElementById('rwFree');
        var rwGolden = document.getElementById('rwGolden');
        modal.querySelectorAll('[data-add]').forEach(function (b) {
            b.addEventListener('click', function () {
                addRow(b.dataset.add === 'free' ? rwFree : rwGolden);
                refreshRaw();
            });
        });

        function open(c) {
            card = c;
            var f = fields(c);
            title.textContent = 'Day ' + c.dataset.day;
            fill(rwFree, f.free.value);
            fill(rwGolden, f.golden.value);
            refreshRaw();
            mFreeText.value = f.freeText.value;
            mGoldenText.value = f.goldenText.value;
            mMilestone.checked = f.milestone.checked;
            // Show what the card WOULD say if the text is left blank, so the placeholder is the real fallback.
            mFreeText.placeholder = c.dataset.freeAuto || '';
            mGoldenText.placeholder = c.dataset.goldenAuto || '';
            modal.hidden = false;
        }

        function close() { modal.hidden = true; card = null; }

        function apply() {
            if (!card) return close();
            refreshRaw();   // rebuild from the rows, so nothing typed since the last input event is lost
            var f = fields(card);
            f.free.value = mFree.value;
            f.freeText.value = mFreeText.value;
            f.golden.value = mGolden.value;
            f.goldenText.value = mGoldenText.value;
            f.milestone.checked = mMilestone.checked;

            // Repaint the card so the grid reflects the edit before the form is posted.
            var tracks = card.querySelectorAll('.track');
            var freeShown = mFreeText.value.trim() || (card.dataset.freeAuto || '');
            var goldShown = mGoldenText.value.trim() || (card.dataset.goldenAuto || '');
            tracks[0].querySelector('.v-text').textContent = freeShown;
            tracks[0].querySelector('.v-line').textContent = mFree.value;
            tracks[1].querySelector('.v-text').textContent = goldShown;
            tracks[1].querySelector('.v-line').textContent = mGolden.value || '—';
            card.classList.toggle('is-milestone', mMilestone.checked);

            close();
        }

        document.querySelectorAll('.day-card').forEach(function (c) {
            c.addEventListener('click', function () { open(c); });
            c.addEventListener('keydown', function (e) {
                if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); open(c); }
            });
        });

        modal.querySelectorAll('[data-close]').forEach(function (b) { b.addEventListener('click', close); });
        document.getElementById('mApply').addEventListener('click', apply);
        // Click the backdrop (not the dialog) to dismiss.
        modal.addEventListener('click', function (e) { if (e.target === modal) close(); });
        document.addEventListener('keydown', function (e) { if (!modal.hidden && e.key === 'Escape') close(); });
    })();
</script>
