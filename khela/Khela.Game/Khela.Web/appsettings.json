{
  "ConnectionStrings": {
    //"DefaultConnection": "server=localhost;port=3306;database=Khela;user=root;password=reza@865174;",
    "DefaultConnection": "server=213.199.37.146;port=3306;database=Khela;user=myuser;password=StrongPassword123!",
    "RedisConnection": "127.0.0.1:6379",
    "RedisConnectionDevelopment": "127.0.0.1:6379,password="
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "/var/khela_Web/khela_web-.log",
          "rollingInterval": "Day",
          "rollOnFileSizeLimit": true,
          "fileSizeLimitBytes": 52428800,
          "retainedFileCountLimit": 30,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {SourceContext} {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "AllowedHosts": "*",

  // MIRROR of the engine's defaults in Khela.Game/appsettings.json — the Settings page shows the EFFECTIVE value as
  // "Redis override ?? appsettings default", so without these it renders the game knobs blank and an operator cannot
  // see what production is actually running. Keep in step with Khela.Game/appsettings.json; the engine reads its own
  // copy, these are only what the dashboard displays when no override is set.
  "Blackjack": {
    "DeckCount": 6,
    "ShoePenetrationPercent": 75,
    "ReshuffleEveryRound": 0,
    "TurnSeconds": 15,
    "InsuranceSeconds": 12,
    "BettingSeconds": 15,
    "MaxIdleBettingWindows": 3
  },
  "Table": {
    "HeartbeatIntervalSeconds": 5,
    "StalledTimeoutSeconds": 30,
    "DisconnectGraceSeconds": 20
  },

  "Admin": {
    "_comment": "AspNetUsers.Id (GUID) values allowed into the dashboard in production. Development is open.",
    "UserIds": []
  }
}
